{
    "name": "phil/transcription",
    "description": "Transcription of recordings behind one port: a whisper.cpp server run by the site, OpenAI and Deepgram adapters refused without the consent of the people heard, timestamped segments turned into phil/timed-text tracks, a declared language, and a review before publication.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "transcription",
        "speech-to-text",
        "whisper",
        "captions",
        "privacy"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "phil/timed-text": "^0.1@dev",
        "symfony/http-client-contracts": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/http-client": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Transcription\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Transcription\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
