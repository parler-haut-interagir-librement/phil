{
    "name": "phil/money",
    "description": "Handle money without rounding errors: exact integer amounts in a known currency, parsed and printed to its precision, split without ever losing a cent.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "money",
        "currency",
        "iso4217",
        "value-object",
        "ddd"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "symfony/intl": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Money\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Money\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
