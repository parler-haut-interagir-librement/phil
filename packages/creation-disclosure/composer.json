{
    "name": "phil/creation-disclosure",
    "description": "How a work was made, declared part by part in the IPTC Digital Source Type vocabulary: captured, made by people, edited or created with generative AI, or undeclared, with the AI-free view and the requirement a contest or a shop sets",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "ai-disclosure",
        "c2pa",
        "content-credentials",
        "digital-source-type",
        "generative-ai",
        "iptc",
        "provenance",
        "xmp"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CreationDisclosure\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CreationDisclosure\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
