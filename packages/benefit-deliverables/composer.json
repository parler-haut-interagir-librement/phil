{
    "name": "phil/benefit-deliverables",
    "description": "Track the benefits each member is owed per period as a checklist, with short-lived shipping exports, for subscriptions, memberships and donations.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "benefits",
        "rewards",
        "fulfilment",
        "membership",
        "subscription",
        "shipping"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "phil/address": "^0.1@dev",
        "phil/spreadsheet": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\BenefitDeliverables\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\BenefitDeliverables\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
