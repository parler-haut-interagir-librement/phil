{
    "name": "phil/poll",
    "description": "A voting engine: single, multiple and ranked ballots checked against the rules of a poll, and counted by choices, instant runoff, Borda or Schulze, with shared places, rounds and abstentions, in plain PHP",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "poll",
        "vote",
        "ballot",
        "ranked-choice",
        "instant-runoff",
        "condorcet"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Poll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Poll\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
