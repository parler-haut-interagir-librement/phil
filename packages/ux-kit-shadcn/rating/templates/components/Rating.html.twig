{#-
 # A note out of a number of stars. With a name, a group of radio buttons: the browser gives the keyboard and the
 # form. Without one, the note as a single image, in half stars.
 #}
{%- props
    ## string What is being rated.
    label,
    ## string|null The name of the field; read-only when null.
    name = null,
    ## float The value.
    value = 0,
    ## int How many stars, up to ten.
    max = 5,
    ## string What screen readers read for a note, `{value}` and `{max}` replaced.
    starLabel = '{value} of {max}',
    ## string|null The choice of no star, which makes the note optional; none when null.
    clearLabel = null,
    ## bool Whether a note has to be given.
    required = false,
    ## bool Whether the note cannot be changed for now.
    disabled = false
-%}
{%- set _max = max(1, min(max, 10)) -%}
{%- if name is null -%}
    <span role="img" aria-label="{{ label }} {{ starLabel|replace({'{value}': value, '{max}': _max}) }}" data-slot="rating"{{ attributes.defaults({class: 'm-0 min-w-0 border-0 p-0 inline-flex items-center'}) }}>
        {%- for star in 1.._max -%}<span class="inline-grid text-muted-foreground not-has-[input]:min-h-0 min-h-11 min-w-11 cursor-pointer place-items-center text-xl leading-none has-checked:text-primary has-focus-visible:ring-3 has-focus-visible:ring-ring/50 has-[~_label_input:checked]:text-primary not-has-[input]:min-w-0 not-has-[input]:text-base{{ value >= star ? ' text-primary' : (value >= star - 0.5 ? ' bg-linear-to-r from-primary from-50% to-muted-foreground to-50% bg-clip-text text-transparent rtl:bg-linear-to-l' : '') }}" aria-hidden="true">&#9733;</span>{%- endfor -%}
    </span>
{%- else -%}
    <fieldset data-slot="rating"{{ attributes.defaults({class: 'm-0 min-w-0 border-0 p-0'}|merge(disabled ? {disabled: true} : {})) }}>
        <legend class="p-0 text-sm font-medium">{{ label }}</legend>
        <div class="inline-flex flex-wrap items-center">
            {%- if clearLabel is not null -%}<label class="inline-flex min-h-11 cursor-pointer items-center px-2 text-sm has-focus-visible:ring-3 has-focus-visible:ring-ring/50"><input class="sr-only" type="radio" name="{{ name }}" value="0"{% if value <= 0 %} checked{% endif %}><span>{{ clearLabel }}</span></label>{%- endif -%}
            {%- for star in 1.._max -%}<label class="inline-grid text-muted-foreground not-has-[input]:min-h-0 min-h-11 min-w-11 cursor-pointer place-items-center text-xl leading-none has-checked:text-primary has-focus-visible:ring-3 has-focus-visible:ring-ring/50 has-[~_label_input:checked]:text-primary not-has-[input]:min-w-0 not-has-[input]:text-base"><input class="sr-only" type="radio" name="{{ name }}" value="{{ star }}"{% if value == star %} checked{% endif %}{% if required %} required{% endif %}><span class="block" aria-hidden="true">&#9733;</span><span class="sr-only">{{ starLabel|replace({'{value}': star, '{max}': _max}) }}</span></label>{%- endfor -%}
        </div>
    </fieldset>
{%- endif -%}
