{#-
 # A headline whose words are revealed through a clip, one after the other.
 #
 # Screen readers read the whole headline at once, from a visually hidden copy; the animated words are hidden from
 # them, so nothing is announced while they change. Without JavaScript, or under prefers-reduced-motion, the first
 # word stands still. One word is revealed once; several are played through once, back to the first, within five
 # seconds; with `loop`, they keep cycling and a pause/play button, shown by the controller, stops them.
 #}
{%- props
    ## list<string>|string The word, or the words to cycle through; one word is revealed once.
    words,
    ## string|null Static text before the words.
    text = null,
    ## string|null Static text after the words.
    suffix = null,
    ## int The level of the heading, from 1 to 6.
    level = 1,
    ## string|null What screen readers read instead of the text, the words joined and the suffix.
    label = null,
    ## string What joins the words in what screen readers read.
    separator = ', ',
    ## int Milliseconds a word rests before the next one.
    pause = 2500,
    ## int Milliseconds the clip takes to close, and as many to open.
    duration = 600,
    ## bool Whether the words keep cycling, with a pause/play button, instead of playing through once.
    loop = false,
    ## string The button's text while the words cycle, with `loop`.
    pauseLabel = 'Pause animation',
    ## string The button's text while they are paused, with `loop`.
    playLabel = 'Play animation'
-%}
{%- set _words = words is iterable ? words : [words] -%}
{%- set _level = max(1, min(6, level)) -%}
{%- set _cycles = loop and _words|length > 1 -%}
{%- set _id = 'animated-headline-' ~ random() -%}
{%- set _label = label ?? ([text, _words|join(separator), suffix]|filter(part => part is not null and part is not same as(''))|join(' ')) -%}
<h{{ _level }} data-slot="animated-headline" data-animated-headline-pause-value="{{ pause }}" data-animated-headline-duration-value="{{ duration }}" data-animated-headline-loop-value="{{ _cycles ? 'true' : 'false' }}"{% if _cycles %} data-animated-headline-pause-label-value="{{ pauseLabel }}" data-animated-headline-play-label-value="{{ playLabel }}" aria-labelledby="{{ _id }}"{% endif %}{{ attributes.defaults({class: 'scroll-m-20 text-4xl font-extrabold tracking-tight text-balance lg:text-5xl', 'data-controller': 'animated-headline'}) }}>
    <span{% if _cycles %} id="{{ _id }}"{% endif %} class="sr-only">{{ _label }}</span>
    <span aria-hidden="true">
        {%- if text is not null and text is not same as('') %}{{ text }} {% endif -%}
        <span class="inline-grid overflow-hidden border-e-[0.06em] border-transparent align-bottom [--phil-reveal-caret:0.06em] w-(--phil-reveal-size) transition-[width] duration-(--phil-reveal-duration) ease-in-out motion-reduce:w-auto motion-reduce:transition-none [&.isRevealing]:border-current [&.isPulsing]:border-transparent motion-reduce:[&.isRevealing]:border-transparent" aria-live="off" data-animated-headline-target="reveal">
            {%- for word in _words -%}
                <span class="{{ loop.first ? 'isCurrent ' }}invisible col-start-1 row-start-1 justify-self-start whitespace-nowrap [&.isCurrent]:visible" data-animated-headline-target="word">{{ word }}</span>
            {%- endfor -%}
        </span>
        {%- if suffix is not null and suffix is not same as('') %} {{ suffix }}{% endif -%}
    </span>
    {%- if _cycles %}
    <button type="button" data-slot="animated-headline-toggle" class="ms-3 inline-flex cursor-pointer items-center rounded-lg border border-border bg-background px-3 py-1 align-middle text-sm font-medium tracking-normal text-foreground outline-none hover:bg-muted hover:text-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50" hidden data-animated-headline-target="toggle" data-action="animated-headline#toggle">{{ pauseLabel }}</button>
    {%- endif %}
</h{{ _level }}>
