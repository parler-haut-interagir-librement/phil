{%- props
    ## 'horizontal'|'vertical' The axis the slides scroll along.
    orientation = 'horizontal',
    ## 'start'|'center'|'end' The alignment of the selected slide inside the viewport.
    align = 'center',
    ## bool Whether the carousel wraps around after the last slide.
    loop = false,
    ## array Extra options read by the controller, merged over `align` and `loop`.
    options = {},
    ## int The delay in milliseconds between two automatic slide changes. Zero disables autoplay.
    autoplay = 0,
    ## string The accessible name of the carousel region.
    label = 'Carousel',
    ## string What the carousel is announced as.
    roleDescription = 'carousel',
    ## string The text of the button while the slides play.
    pauseLabel = 'Pause',
    ## string The text of the button once paused.
    playLabel = 'Play'
-%}
{%- set _carousel_options = {align: align, loop: loop}|merge(options) -%}
{%- do provide('carousel.orientation', orientation) -%}
{%- do provide('carousel.loop', _carousel_options.loop) -%}
<div role="region" aria-roledescription="{{ roleDescription }}" tabindex="0" data-slot="carousel" data-orientation="{{ orientation }}" data-align="{{ align }}" data-carousel-orientation-value="{{ orientation }}" data-carousel-options-value="{{ _carousel_options|json_encode }}" data-carousel-autoplay-value="{{ autoplay }}" data-carousel-pause-label-value="{{ pauseLabel }}" data-carousel-play-label-value="{{ playLabel }}"{{ attributes.defaults({class: 'group/carousel mb-4 grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-1 rounded-lg outline-none focus-visible:ring-3 focus-visible:ring-ring/50 print:block', 'aria-label': label, 'data-controller': 'carousel', 'data-action': 'keydown->carousel#handleKeydown mouseenter->carousel#hold mouseleave->carousel#release focusin->carousel#hold focusout->carousel#release'}) }}>
{##- The carousel structure, typically includes `Carousel:Content`, `Carousel:Previous` and `Carousel:Next`. -#}
{%- block content %}{% endblock -%}
{%- if autoplay > 0 %}
<button type="button" class="col-span-full inline-flex h-7 shrink-0 cursor-pointer items-center justify-center gap-1 justify-self-center rounded-[min(var(--radius-md),12px)] border border-transparent px-2.5 text-[0.8rem] font-medium whitespace-nowrap transition-all outline-none select-none hover:bg-muted hover:text-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 dark:hover:bg-muted/50 print:hidden" hidden data-slot="carousel-toggle" data-carousel-target="toggle" data-action="click->carousel#toggleAutoplay">{{ pauseLabel }}</button>
{%- endif %}
</div>
