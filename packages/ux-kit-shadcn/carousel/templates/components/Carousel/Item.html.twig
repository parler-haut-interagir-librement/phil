{%- props
    ## string What the slide is announced as.
    roleDescription = 'slide'
-%}
<div role="group" aria-roledescription="{{ roleDescription }}" data-slot="carousel-item"{{ attributes.defaults({class: 'min-w-0 shrink-0 grow-0 basis-[var(--carousel-item,100%)] snap-start group-data-[align=center]/carousel:snap-center group-data-[align=end]/carousel:snap-end print:break-inside-avoid'}) }}>
{##- The slide content. -#}
{%- block content %}{% endblock -%}
</div>
