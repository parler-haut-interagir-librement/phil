{#-
 # The colour well of the browser, the hexadecimal value beside it and swatches to choose from. The well is the field:
 # it works alone without a script, which only adds the rest.
 #}
{%- props
    ## string The name the colour well is read by.
    label,
    ## string|null The identifier of the field.
    id = null,
    ## string|null The name of the field.
    name = null,
    ## string The colour, as `#rrggbb`; anything else is black.
    value = '#000000',
    ## array The colours to choose from: `#rrggbb`, or maps of `value` and `label`.
    swatches = [],
    ## string The name of the text field.
    valueLabel = 'Hexadecimal value',
    ## string The name of the group of swatches.
    swatchesLabel = 'Suggested colours',
    ## bool Whether the field cannot be changed for now.
    disabled = false
-%}
{%- set _value = value matches '/^#[0-9a-fA-F]{6}$/' ? value|lower : '#000000' -%}
<div data-slot="color-picker"{{ attributes.defaults({class: 'inline-flex max-w-full flex-wrap items-center gap-2', 'data-controller': 'color-picker'}) }}>
    <input class="size-8 shrink-0 cursor-pointer rounded-lg border border-input p-0 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50" type="color" value="{{ _value }}" aria-label="{{ label }}"{% if id is not null %} id="{{ id }}"{% endif %}{% if name is not null %} name="{{ name }}"{% endif %}{% if disabled %} disabled{% endif %} data-color-picker-target="well" data-action="input->color-picker#pick">
    <input class="h-8 rounded-lg border border-input bg-transparent px-2.5 py-1 text-base dark:bg-input/30 md:text-sm aria-invalid:border-destructive disabled:cursor-not-allowed disabled:opacity-50 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 w-[11ch] font-mono" type="text" hidden value="{{ _value }}" aria-label="{{ valueLabel }}" maxlength="7" spellcheck="false" autocomplete="off"{% if disabled %} disabled{% endif %} data-color-picker-target="text" data-action="change->color-picker#type">
    {%- if swatches is not empty -%}
        <div class="flex flex-wrap gap-1" role="group" aria-label="{{ swatchesLabel }}">
            {%- for swatch in swatches -%}
                {%- set _swatch = swatch is iterable ? swatch : {value: swatch, label: swatch} -%}
                <button type="button" class="size-8 cursor-pointer rounded-full border border-input aria-pressed:ring-2 aria-pressed:ring-foreground outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50" hidden aria-label="{{ _swatch.label }}" title="{{ _swatch.label }}" aria-pressed="false"{% if disabled %} disabled{% endif %} data-color-picker-target="swatch" data-color-picker-color-param="{{ _swatch.value }}" data-action="color-picker#choose"></button>
            {%- endfor -%}
        </div>
    {%- endif -%}
</div>
