{#-
 # The choice of the colour scheme: light, dark or the system's, three radio buttons in a group that stays hidden until
 # its controller runs. The choice is kept in the browser; `ThemeSwitcher:Script`, in the head, writes it on the root
 # before the page is first painted.
 #}
{%- props
    ## string What screen readers call the group.
    label = 'Theme',
    ## string The name of the light scheme.
    lightLabel = 'Light',
    ## string The name of the dark scheme.
    darkLabel = 'Dark',
    ## string The name of the scheme of the system.
    systemLabel = 'System',
    ## string The name of the radio buttons, unique in the page.
    name = 'theme',
    ## string The key of the choice in the storage of the browser, the same as that of the script.
    storageKey = 'theme'
-%}
<fieldset hidden data-slot="theme-switcher" data-theme-switcher-key-value="{{ storageKey }}"{{ attributes.defaults({class: 'm-0 inline-flex min-w-0 flex-wrap gap-1 border-0 p-0', 'data-controller': 'theme-switcher'}) }}>
    <legend class="sr-only">{{ label }}</legend>
    {%- for theme, text in {light: lightLabel, dark: darkLabel, system: systemLabel} -%}
    <label class="inline-flex h-9 min-w-9 cursor-pointer items-center justify-center rounded-md border border-input bg-transparent px-3 text-sm font-medium whitespace-nowrap transition-colors hover:bg-muted hover:text-muted-foreground has-checked:bg-accent has-checked:text-accent-foreground has-focus-visible:border-ring has-focus-visible:ring-3 has-focus-visible:ring-ring/50 motion-reduce:transition-none"><input type="radio" class="sr-only" name="{{ name }}" value="{{ theme }}"{{ theme is same as('system') ? ' checked' }} data-theme-switcher-target="option" data-action="theme-switcher#choose">{{ text }}</label>
    {%- endfor -%}
</fieldset>
