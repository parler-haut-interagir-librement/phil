{#-
 # A number field, with a button on each side once a script can drive them. The keyboard stays the field's own: the
 # buttons are for the pointer and are left out of the Tab order, as in the spin button of WAI-ARIA.
 #}
{%- props
    ## string|null The identifier of the field, for a `label` beside it.
    id = null,
    ## string|null The name of the field.
    name = null,
    ## int|float|null The value.
    value = null,
    ## int|float|null The lowest value.
    min = null,
    ## int|float|null The highest value.
    max = null,
    ## int|float|string The step, or `any`.
    step = 1,
    ## string|null What screen readers call the field, without a `label` beside it.
    label = null,
    ## string The name of the button that lowers the value.
    decrementLabel = 'Decrease',
    ## string The name of the button that raises the value.
    incrementLabel = 'Increase',
    ## bool Whether a value has to be given.
    required = false,
    ## bool Whether the field cannot be changed for now.
    disabled = false
-%}
<div data-slot="number-input"{{ attributes.defaults({class: 'inline-flex max-w-full items-stretch', 'data-controller': 'number-input'}) }}>
    <button type="button" class="inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 rounded-lg text-sm font-medium whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 border border-border bg-background hover:bg-muted hover:text-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50 size-9 first:rounded-e-none last:rounded-s-none" hidden tabindex="-1" aria-label="{{ decrementLabel }}" data-number-input-target="decrement" data-action="number-input#decrement"><span aria-hidden="true">&minus;</span></button>
    <input class="h-8 rounded-lg border border-input bg-transparent px-2.5 py-1 text-base dark:bg-input/30 md:text-sm aria-invalid:border-destructive disabled:cursor-not-allowed disabled:opacity-50 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 w-24 rounded-none text-center [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" type="number" inputmode="decimal" step="{{ step }}"{% if id is not null %} id="{{ id }}"{% endif %}{% if name is not null %} name="{{ name }}"{% endif %}{% if value is not null %} value="{{ value }}"{% endif %}{% if min is not null %} min="{{ min }}"{% endif %}{% if max is not null %} max="{{ max }}"{% endif %}{% if label is not null %} aria-label="{{ label }}"{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %} data-number-input-target="input" data-action="input->number-input#refresh change->number-input#refresh">
    <button type="button" class="inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 rounded-lg text-sm font-medium whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 border border-border bg-background hover:bg-muted hover:text-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50 size-9 first:rounded-e-none last:rounded-s-none" hidden tabindex="-1" aria-label="{{ incrementLabel }}" data-number-input-target="increment" data-action="number-input#increment"><span aria-hidden="true">&plus;</span></button>
</div>
