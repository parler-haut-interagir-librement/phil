{#-
 # The status of a form's draft, for the autosave controller of phil/forms-autosave on the form's tag: a polite live
 # region the controller writes what it did in, and the notice of a restored draft or of a newer one, hidden until
 # then, with its buttons. Written inside the form.
 #}
{%- props
    ## string The button that puts the shown values back and forgets the draft.
    discardLabel = 'Discard the draft',
    ## string The button that hides the notice and keeps the values in the form.
    dismissLabel = 'Keep it',
    ## string The button that puts the newer draft of another device or tab in the form.
    useServerLabel = 'Use the newer draft'
-%}
{%- set _button = 'inline-flex cursor-pointer items-center rounded-lg border border-border bg-background px-3 py-1 text-sm font-medium text-foreground outline-none hover:bg-muted hover:text-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 [&[hidden]]:hidden' -%}
<div data-slot="autosave-status"{{ attributes.defaults({class: 'grid gap-2'}) }}>
    <p class="min-h-5 text-sm text-muted-foreground" role="status" aria-live="polite" data-phil--forms-autosave--autosave-target="status"></p>
    <div class="flex flex-wrap items-center gap-2 rounded-lg border px-4 py-3 [&[hidden]]:hidden" role="group" hidden data-phil--forms-autosave--autosave-target="notice">
        <p class="m-0 flex-1 basis-64" data-phil--forms-autosave--autosave-target="message"></p>
        <button type="button" class="{{ _button }}" hidden data-phil--forms-autosave--autosave-target="useServer" data-action="phil--forms-autosave--autosave#useServer">{{ useServerLabel }}</button>
        <button type="button" class="{{ _button }}" data-phil--forms-autosave--autosave-target="discard" data-action="phil--forms-autosave--autosave#discard">{{ discardLabel }}</button>
        <button type="button" class="{{ _button }}" data-phil--forms-autosave--autosave-target="dismiss" data-action="phil--forms-autosave--autosave#dismiss">{{ dismissLabel }}</button>
    </div>
</div>
