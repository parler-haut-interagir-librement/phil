{
    "name": "phil/migration",
    "description": "Doctrine migrations that announce what they bring: release notes and news gathered over one run and sent once, in messages cut to fit a chat transport",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "doctrine",
        "migrations",
        "release-notes",
        "notifier",
        "discord"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "doctrine/migrations": "^3.9",
        "psr/log": "^3.0",
        "symfony/notifier": "^8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^4.3",
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Migration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Migration\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
