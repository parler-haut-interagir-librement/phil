{
    "name": "phil/lti-bundle",
    "description": "phil/lti in Symfony: an LTI 1.3 tool, platform or both, with the routes of the launch, Deep Linking and the key set, an authenticator for verified launches, the platform services, Doctrine DBAL stores, keys sealed by Symfony KeyManagement and rotated, scores sent through Messenger, and events for the gradebook",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "lti",
        "lti-advantage",
        "deep-linking",
        "e-learning",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.5",
        "phil/lti": "^0.2@dev",
        "phil/safe-http": "^0.2.1@dev",
        "phil/url": "^0.1.4@dev",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/security-core": "^8.2",
        "symfony/security-http": "^8.2",
        "symfony/service-contracts": "^3.6",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "ext-dom": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "phil/ux-kit": ">=0.5.0-alpha <1.0",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/asset-mapper": "^8.2",
        "symfony/browser-kit": "^8.2",
        "symfony/cache": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/console": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/dom-crawler": "^8.1",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/key-management": "^8.2",
        "symfony/messenger": "^8.2",
        "symfony/security-bundle": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/ux-twig-component": "^3.7",
        "web-token/jwt-library": "^4.2"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "For the DBAL connection the store \"dbal\" names",
        "doctrine/orm": "To add the bundle's tables to the schema the ORM generates, and so to its migrations",
        "symfony/asset-mapper": "To serve the Stimulus controller that posts the forms of a launch",
        "symfony/console": "For phil:lti:schema, phil:lti:rotate-keys and phil:lti:purge",
        "symfony/key-management": "To seal the keys the bundle makes and rotates in its table",
        "symfony/messenger": "To send the scores of the tool through a bus, with retries",
        "symfony/ux-twig-component": "For the recipe Button of the kit that the form of a launch shows without scripts"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\LtiBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\LtiBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
