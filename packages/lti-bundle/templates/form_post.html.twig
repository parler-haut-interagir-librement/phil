{#
 # A form the browser posts to the other side of a launch — an id_token, a deep linking response —, which submits
 # itself through the short inline script of the block `auto_submit`, allowed by the nonce of the page's content
 # security policy: it needs neither the importmap nor the Stimulus application of the site. Without scripts, its
 # button is the recipe `Button` of the kit, installed by the Symfony UX Toolkit. A site that loads its own importmap in
 # the block `head` gives it the nonce, `importmap('app', {nonce: csp_nonce})`; the Stimulus controller of the bundle
 # then sees the form already sent and does nothing.
 #
 # action: the address the form posts to. fields: the names and values of the hidden fields. csp_nonce: the nonce of
 # the page's scripts.
 #}
<!doctype html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <title>{{ 'form_post.title'|trans({}, 'phil_lti') }}</title>
    {% block head %}{% endblock %}
</head>
<body>
<main class="phil-lti-form-post">
    <form method="post" action="{{ action }}" data-controller="phil--lti-bundle--auto-submit">
        {%- for name, value in fields %}
        <input type="hidden" name="{{ name }}" value="{{ value }}">
        {%- endfor %}
        <p>{{ 'form_post.message'|trans({}, 'phil_lti') }}</p>
        <noscript><p>{{ 'form_post.no_script'|trans({}, 'phil_lti') }}</p></noscript>
        {% component (phil_lti_kit('Button')) with {type: 'submit', variant: 'default'} %}{% block content %}{{ 'form_post.continue'|trans({}, 'phil_lti') }}{% endblock %}{% endcomponent %}
    </form>
    {%- block auto_submit %}
    <script nonce="{{ csp_nonce }}">
        (function (form) {
            if (!form || form.dataset.philLtiSubmitted) {
                return;
            }

            form.dataset.philLtiSubmitted = '1';
            var button = form.querySelector('[type="submit"]');

            if (button) {
                button.disabled = true;
            }

            form.submit();
        })(document.currentScript.previousElementSibling);
    </script>
    {%- endblock %}
</main>
</body>
</html>
