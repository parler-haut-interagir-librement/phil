{
    "name": "phil/pwa-bundle",
    "description": "An installable, offline-readable Symfony site without Workbox: a web application manifest from the configuration, a service worker served through AssetMapper with network-first and cache-first strategies, an offline page, a versioned precache list, and Stimulus controllers to install, update and present",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "pwa",
        "service-worker",
        "web-app-manifest",
        "offline",
        "presentation-api",
        "stimulus",
        "asset-mapper",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-uri": "*",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/routing": "^8.2",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/asset": "^8.2",
        "symfony/asset-mapper": "^8.2",
        "symfony/browser-kit": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/dom-crawler": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/translation": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2"
    },
    "suggest": {
        "symfony/asset-mapper": "To serve the service worker and the Stimulus controllers, and version the precached assets",
        "symfony/stimulus-bundle": "For the controllers that register the worker and present a page on a second screen",
        "symfony/translation": "For the offline page in English and French"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\PwaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\PwaBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
