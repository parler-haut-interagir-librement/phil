{
    "name": "@phil/pwa-bundle",
    "description": "The service worker and the Stimulus controllers of phil/pwa-bundle: registering the worker, installing and updating the site, and a presentation on a second screen",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "main": "src/pwa_controller.js",
    "symfony": {
        "controllers": {
            "pwa": {
                "main": "src/pwa_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            },
            "presentation": {
                "main": "src/presentation_controller.js",
                "webpackMode": "lazy",
                "fetch": "lazy",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0"
    }
}
