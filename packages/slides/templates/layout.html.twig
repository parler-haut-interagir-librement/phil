{#
    The page around the presenter view when the application names no layout of its own: the application's layout fills
    the same two blocks, "title" and "main", and loads the controllers and the stylesheet of the bundle.
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}{% endblock %}</title>
</head>
<body>
    <main class="phil-slides-page">
        {% block main %}{% endblock %}
    </main>
</body>
</html>
