{
    "name": "phil/highlight",
    "description": "Syntax highlighting on the server for 24 languages, by small tokenizers written from scratch, as HTML spans with hl- classes and CSS themes",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "syntax-highlighting",
        "highlighter",
        "tokenizer",
        "code",
        "html"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Highlight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Highlight\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
