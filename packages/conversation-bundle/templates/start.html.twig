{#
 # The form that writes to a member: the direct conversation of the two, started or taken up again.
 #
 # to: the recipient's ParticipantId. error: why the message was refused, or null. body: what was written.
 #}
{% extends layout %}

{%- set name = phil_conversation_name(to) -%}

{% block title %}{{ 'start.title'|trans({'%name%': name}, 'phil_conversation') }}{% endblock %}

{% block main %}
<p><a href="{{ path('phil_conversation_inbox') }}">{{ 'inbox.title'|trans({}, 'phil_conversation') }}</a></p>
<h1>{{ 'start.title'|trans({'%name%': name}, 'phil_conversation') }}</h1>
<form method="post" action="{{ path('phil_conversation_start', {participant: to.value}) }}" class="phil-conversation__reply">
    <input type="hidden" name="_token" value="{{ token }}">
    <label for="phil-conversation-body">{{ 'thread.reply'|trans({}, 'phil_conversation') }}</label>
    {%- if error is not null %}
    <p id="phil-conversation-error" class="phil-conversation__error" role="alert">{{ error }}</p>
    {%- endif %}
    {% component (phil_conversation_kit('Textarea')) with {id: 'phil-conversation-body', name: 'body', rows: 6, required: true, 'aria-describedby': error is not null ? 'phil-conversation-error' : false} %}{% block content %}{{ body }}{% endblock %}{% endcomponent %}
    {% component (phil_conversation_kit('Button')) with {type: 'submit'} %}{% block content %}{{ 'thread.send'|trans({}, 'phil_conversation') }}{% endblock %}{% endcomponent %}
</form>
{% endblock %}
