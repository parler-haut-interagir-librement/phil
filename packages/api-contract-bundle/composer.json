{
    "name": "phil/api-contract-bundle",
    "description": "Both sides of an unversioned HTTP API contract for Symfony, on phil/api-contract and phil/idempotency: exceptions as problem details, #[Idempotent] controllers with keys in Doctrine or a cache pool, #[DeprecatedEndpoint] controllers, the deprecations of called APIs recorded and checked in CI, and its OpenAPI document checked by level",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "api",
        "deprecation",
        "idempotency",
        "openapi",
        "problem-details",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-uri": "*",
        "phil/api-contract": "^0.1@dev",
        "phil/idempotency": "^0.1@dev",
        "psr/clock": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "phpunit/phpunit": "^13.4",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/cache": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/http-client-contracts": "^3.6",
        "symfony/lock": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/security-core": "^8.2",
        "symfony/yaml": "^8.2"
    },
    "suggest": {
        "doctrine/dbal": "To keep the idempotency keys in a table",
        "symfony/console": "For phil:api-contract:deprecations and phil:api-contract:verify",
        "symfony/http-client": "To record the deprecations of the APIs this application calls",
        "symfony/lock": "To keep the idempotency keys in a cache pool",
        "symfony/security-core": "To scope idempotency keys by user",
        "symfony/yaml": "To verify an OpenAPI document written in YAML"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\ApiContractBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\ApiContractBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
