{
    "name": "phil/open-badges",
    "description": "Issue Open Badges 3.0 that anyone can verify: signed, baked into the image, revoked, endorsed and gathered in a learner record (CLR 2.0).",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "open-badges",
        "verifiable-credentials",
        "clr",
        "data-integrity",
        "jwt",
        "badges"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "ext-zlib": "*",
        "phil/safe-http": "^0.2@dev",
        "phil/url": "^0.1@dev",
        "symfony/service-contracts": "^3.8",
        "web-token/jwt-library": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/http-client": "^8.2",
        "symfony/http-client-contracts": "^3.8"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\OpenBadges\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\OpenBadges\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    }
}
