{
    "name": "phil/tax",
    "description": "Several taxes on one sale, such as federal and provincial, each computed on the same base and itemised to the cent, then reversed exactly by a credit note.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "tax",
        "vat",
        "sales-tax",
        "money",
        "ddd"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/money": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Tax\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Tax\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
