{
    "name": "phil/stockroom",
    "description": "Track what a troupe, convention or school owns and lends: nested containers, items, a journal of every movement, and load lists per event checked at the return.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "stockroom",
        "inventory",
        "props",
        "load-list",
        "stock-movements"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "psr/clock": "^1.0",
        "symfony/service-contracts": "^3.8",
        "symfony/uid": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Stockroom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Stockroom\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
