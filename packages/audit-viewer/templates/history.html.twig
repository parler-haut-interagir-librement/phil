{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'title.history'|trans({'%type%': subject.type, '%id%': subject.id}, 'phil_audit_viewer') }}{% endblock %}

{% block main %}
    {% set route = ea().dashboardRouteName ~ '_audit_' %}

    {% if page.rows is empty %}
        <p>{{ 'history.empty'|trans({}, 'phil_audit_viewer') }}</p>
    {% else %}
        <ol class="list-unstyled">
            {% for row in page.rows %}
                <li class="mb-3">
                    <h2 class="h6 mb-1">
                        <time datetime="{{ row.instant() }}">{{ row.recordedAt|date('Y-m-d H:i:s', timezone) }}</time>
                        {% set label = row.facts.action ?? ('kind.' ~ row.kind.value)|trans({}, 'phil_audit_viewer') %}
                        · {% if viewer %}<a href="{{ path(route ~ 'row', {segment: row.segment, sequence: row.sequence}) }}">{{ label }}</a>{% else %}{{ label }}{% endif %}
                        {% if row.facts.actor is not null %}· {{ 'history.by'|trans({'%actor%': row.facts.actor}, 'phil_audit_viewer') }}{% endif %}
                    </h2>
                    {% if fields[loop.index0] is not null %}
                        {{ include('@PhilAuditViewer/_fields.html.twig', {fields: fields[loop.index0], row: row}) }}
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    {% endif %}

    {% if page.next is not null %}
        <a class="btn btn-secondary" rel="next" href="{{ path(route ~ 'history', {type: subject.type, id: subject.id, cursor: page.next.token()}) }}">{{ 'action.next'|trans({}, 'phil_audit_viewer') }}</a>
    {% endif %}
    {% if viewer %}
        <a class="btn btn-link" href="{{ path(route ~ 'log', {subject_type: subject.type, subject_id: subject.id}) }}">{{ 'history.in_log'|trans({}, 'phil_audit_viewer') }}</a>
    {% endif %}
{% endblock %}
