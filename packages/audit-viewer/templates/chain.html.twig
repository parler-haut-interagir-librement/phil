{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'title.chain'|trans({}, 'phil_audit_viewer') }}{% endblock %}

{% block main %}
    {% set route = ea().dashboardRouteName ~ '_audit_' %}
    <p>{{ 'chain.intro'|trans({}, 'phil_audit_viewer') }}</p>

    {% for site, segments in sites %}
        {% if sites|length > 1 or site != '' %}
            <h2 class="h5 mt-4">
                {% if site == '' %}{{ 'chain.shared'|trans({}, 'phil_audit_viewer') }}{% else %}{{ 'chain.site'|trans({'%tenant%': site}, 'phil_audit_viewer') }}{% endif %}
            </h2>
        {% endif %}
        <table class="table datagrid">
            <thead>
            <tr>
                <th scope="col">{{ 'column.segment'|trans({}, 'phil_audit_viewer') }}</th>
                <th scope="col">{{ 'column.head'|trans({}, 'phil_audit_viewer') }}</th>
                <th scope="col">{{ 'column.recorded_at'|trans({}, 'phil_audit_viewer') }}</th>
                <th scope="col"><span class="visually-hidden">{{ 'action.verify_short'|trans({}, 'phil_audit_viewer') }}</span></th>
            </tr>
            </thead>
            <tbody>
            {% for status in segments %}
                <tr>
                    <td>{% if status.base() != status.segment %}<span title="{{ status.segment }}">{{ status.base() }}</span>{% else %}{{ status.segment }}{% endif %}</td>
                    <td>{% if status.head is not null %}<a href="{{ path(route ~ 'row', {segment: status.segment, sequence: status.head.sequence}) }}">#{{ status.head.sequence }}</a>{% endif %}</td>
                    <td>{% if status.head is not null %}<time datetime="{{ status.head.instant() }}">{{ status.head.recordedAt|date('Y-m-d H:i:s', timezone) }}</time>{% endif %}</td>
                    <td><a class="btn btn-sm btn-outline-primary" href="{{ path(route ~ 'verify', {segment: status.segment}) }}">{{ 'action.verify_short'|trans({}, 'phil_audit_viewer') }}</a></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>{{ 'chain.empty'|trans({}, 'phil_audit_viewer') }}</p>
    {% endfor %}
{% endblock %}
