{
    "name": "phil/commerce-product-template-bundle",
    "description": "Every product of a design on a template generated into the Symfony catalogue, with its mockups, its print files and the production orders for the printer.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "commerce",
        "product-template",
        "print-on-demand",
        "print-files",
        "catalog",
        "stimulus",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "doctrine/orm": "^3.7",
        "phil/commerce-bundle": "^0.2@dev || ^0.3@dev",
        "phil/commerce-catalog-bundle": "^0.1@dev",
        "phil/commerce-product-template": "^0.1@dev",
        "phil/ddd-bundle": "^0.1@dev",
        "phil/money": "^0.1@dev",
        "phil/print-compositor": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2"
    },
    "require-dev": {
        "ext-gd": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/persistence": "^4.1",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/event-dispatcher": "^8.2",
        "symfony/event-dispatcher-contracts": "^3.6",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/messenger": "^8.2"
    },
    "suggest": {
        "symfony/messenger": "To produce print files and production orders in a worker"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CommerceProductTemplateBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CommerceProductTemplateBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
