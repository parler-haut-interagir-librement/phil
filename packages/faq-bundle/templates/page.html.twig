{% block title %}{{ 'faq.title'|trans({}, 'phil_faq') }}{% endblock %}

{% block content %}
    <h1>{{ 'faq.title'|trans({}, 'phil_faq') }}</h1>
    {{ component('PhilFaq', {page: page}) }}
{% endblock %}
