{#
 # The page around the questions when the application names no layout of its own: `phil_faq.layout` points to a
 # template of the site that defines the blocks `title` and `content`.
 #}
<!doctype html>
<html lang="{{ app.request.locale|default('en')|replace({_: '-'}) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'faq.title'|trans({}, 'phil_faq') }}{% endblock %}</title>
</head>
<body>
<main>
    {% block content %}{% endblock %}
</main>
</body>
</html>
