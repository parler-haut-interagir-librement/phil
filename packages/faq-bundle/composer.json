{
    "name": "phil/faq-bundle",
    "description": "Frequently asked questions by section, searchable without JavaScript, with stable anchors, anonymous votes and FAQPage structured data.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-bundle",
        "faq",
        "questions",
        "json-ld",
        "schema-org",
        "stimulus"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/orm": "^3.7",
        "phil/markup": "^0.3@dev",
        "phil/slug": "^0.1@dev",
        "phil/structured-data": "^0.1@dev",
        "psr/clock": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/rate-limiter": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/security-csrf": "^8.2",
        "symfony/translation-contracts": "^3.6",
        "symfony/uid": "^8.2",
        "symfony/ux-twig-component": "^3.7",
        "twig/twig": "^3.31.1"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.3",
        "easycorp/easyadmin-bundle": "^5.10.4",
        "phil/ux-kit": ">=0.5.0-alpha <1.0",
        "php-webdriver/webdriver": "^1.16",
        "phpunit/phpunit": "^13.4",
        "symfony/asset-mapper": "^8.2",
        "symfony/browser-kit": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/console": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/dom-crawler": "^8.2",
        "symfony/filesystem": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/panther": "^2.4",
        "symfony/security-bundle": "^8.2",
        "symfony/security-core": "^8.2",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/translation": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/yaml": "^8.2"
    },
    "suggest": {
        "easycorp/easyadmin-bundle": "For the links of the administration in an EasyAdmin back office",
        "phil/ux-kit": "For the recipes the component draws — Button, Input, CopyButton —, through the Symfony UX Toolkit",
        "symfony/asset-mapper": "For the Stimulus controller without a build step",
        "symfony/console": "For phil:faq:export and phil:faq:import, with symfony/yaml",
        "symfony/security-core": "For the role that guards the administration",
        "symfony/stimulus-bundle": "For the search as one types and the votes without leaving the page",
        "symfony/translation": "For the page and the administration in English and French",
        "symfony/yaml": "For phil:faq:export and phil:faq:import, with symfony/console"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\FaqBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\FaqBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
