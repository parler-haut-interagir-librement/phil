{
    "name": "phil/error-tracking",
    "description": "Error tracking kept at home: error events with their chained exceptions, frames, context, release, environment and reduced request, grouped by a stable fingerprint, scrubbed of personal data and secrets before anything is written, sampled and throttled, with the statuses of a group and a storage port",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "error-tracking",
        "exceptions",
        "fingerprint",
        "grouping",
        "scrubbing",
        "privacy",
        "self-hosted"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "phil/ip-anonymizer": "^0.1@dev",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\ErrorTracking\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\ErrorTracking\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
