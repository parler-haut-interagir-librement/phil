{
    "name": "phil/import-wizard",
    "description": "Import CSV files without surprises: a dry run previews each row as create, update or refuse, mappings replay, and rejected rows come back to fix.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "import",
        "csv",
        "dry-run",
        "column-mapping",
        "data-import",
        "lms"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-filter": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\ImportWizard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\ImportWizard\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
