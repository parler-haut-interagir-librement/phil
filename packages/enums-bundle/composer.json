{
    "name": "phil/enums-bundle",
    "description": "Symfony integration of phil/enums: cases translated by their Label and Description, form choices narrowed to a group, a list or a meta value, an EnumSet form type, a validator constraint, Twig functions and filters, a translation extractor, debug and TypeScript commands, JSON Schema, a serializer normalizer and Doctrine types for enum sets",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "enum",
        "symfony",
        "form",
        "validator",
        "translation",
        "twig",
        "serializer",
        "doctrine",
        "typescript"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-tokenizer": "*",
        "phil/enums": "^0.3@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/form": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/translation-contracts": "^3.6",
        "symfony/validator": "^8.2",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "ext-intl": "*",
        "api-platform/json-schema": "^5.0",
        "api-platform/metadata": "^5.0",
        "api-platform/symfony": "^5.0",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "doctrine/persistence": "^4.1",
        "nelmio/api-doc-bundle": "^5.13",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/expression-language": "^8.2",
        "symfony/filesystem": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/maker-bundle": "^1.68",
        "symfony/property-info": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/serializer": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/type-info": "^8.2",
        "symfony/workflow": "^8.2",
        "zircote/swagger-php": "^7.1"
    },
    "suggest": {
        "api-platform/symfony": "To complete the JSON Schema of enum properties",
        "doctrine/dbal": "To store an EnumSet in a column",
        "doctrine/orm": "For the phil:enums:check-sets command",
        "nelmio/api-doc-bundle": "To describe enum models with names, descriptions and defaults",
        "symfony/console": "For the debug:enums and phil:enums:typescript commands",
        "symfony/expression-language": "For the enum_meta, enum_in_group and enum_from expression functions",
        "symfony/http-kernel": "For the #[ParseEnum] controller argument resolver",
        "symfony/maker-bundle": "For the make:enum command",
        "symfony/serializer": "To write enum sets, enum maps and labelled cases",
        "symfony/translation": "For the translation extractor and the translation check of debug:enums",
        "symfony/workflow": "For state machines built from #[TransitionsTo]"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\EnumsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\EnumsBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
