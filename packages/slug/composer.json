{
    "name": "phil/slug",
    "description": "Turn titles and names into clean URL slugs, kept in a type that accepts nothing else, with a slugger per use that you can adjust.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "slug",
        "slugger",
        "url",
        "value-object"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "symfony/string": "^8.2",
        "symfony/translation-contracts": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "ext-intl": "For transliteration of every script, not only the Latin ones"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Slug\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Slug\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
