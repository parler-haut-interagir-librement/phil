{
    "name": "phil/print-compositor",
    "description": "Draw the product mockups a shop shows and the print files a printer receives from the same layers, with GD: artworks, fitted texts and one file per ink.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "print",
        "mockup",
        "print-on-demand",
        "gd",
        "png",
        "webp"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "phil/fonts": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\PrintCompositor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\PrintCompositor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
