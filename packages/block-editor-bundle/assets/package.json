{
    "name": "@phil/block-editor-bundle",
    "description": "The block editor's Stimulus controller: UJO blocks edited in place, with a slash menu, drag handles, an inline toolbar, clean paste, nested blocks and columns, mentions, page links and image uploads",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "main": "src/editor_controller.js",
    "symfony": {
        "controllers": {
            "editor": {
                "main": "src/editor_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0",
            "prosemirror-model": "1.25.12",
            "prosemirror-state": "1.4.4",
            "prosemirror-transform": "1.12.4",
            "prosemirror-view": "1.42.9"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0"
    }
}
