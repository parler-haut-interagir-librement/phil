{
    "name": "phil/footnotes-sidenotes",
    "description": "Footnotes and margin notes for UJO (Universal JSON Output) documents: references and notes resolved in reading order, numbered and checked, written as accessible endnotes, as sidenotes with CSS only, or at the foot of the printed page in CSS GCPM",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "footnotes",
        "sidenotes",
        "endnotes",
        "ujo",
        "accessibility",
        "paged-media",
        "gcpm"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-hash": "*",
        "ext-mbstring": "*",
        "phil/ujo": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "phil/paged-media": "To turn the print output into a PDF",
        "phil/typography": "To set the text of notes with the typography of a locale"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\FootnotesSidenotes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\FootnotesSidenotes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
