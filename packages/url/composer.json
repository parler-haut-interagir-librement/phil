{
    "name": "phil/url",
    "description": "Web addresses as clean, normalised values, with their kind detected: a Facebook page, a YouTube channel, a Mastodon account or a plain website.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "url",
        "social-networks",
        "validation",
        "enum",
        "value-object"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-uri": "*",
        "phil/enums": "^0.3@dev",
        "symfony/polyfill-intl-idn": "^1.43"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "ext-intl": "Faster international hosts than the polyfill, and their display in their own letters: without its spoof checker, an international host is displayed in ASCII"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Url\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Url\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
