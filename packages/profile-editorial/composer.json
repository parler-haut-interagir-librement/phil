{
    "name": "phil/profile-editorial",
    "description": "One require for the PHIL packages that publish editorial content in Symfony: safe markup, citations, footnotes, content warnings and schema.org data.",
    "license": "MIT",
    "type": "metapackage",
    "keywords": [
        "profile",
        "metapackage",
        "editorial",
        "markdown",
        "citations",
        "footnotes",
        "content-warnings",
        "schema.org",
        "symfony"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/citations": "^0.1",
        "phil/content-warnings-bundle": "^0.1",
        "phil/footnotes-sidenotes": "^0.1",
        "phil/markup-bundle": "^0.1",
        "phil/structured-data-bundle": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/dependency-injection": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/twig-bundle": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Phil\\Profile\\Editorial\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
