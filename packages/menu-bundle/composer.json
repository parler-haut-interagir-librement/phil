{
    "name": "phil/menu-bundle",
    "description": "Menus for Symfony: trees of items built in code, decorated by the application — counts, classes, badges —, their current item and ancestors marked from the request, a breadcrumb, and lists or cards in Twig",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "menu",
        "navigation",
        "breadcrumb",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/config": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/translation-contracts": "^3.6",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "symfony/routing": "For the routes of items in the templates, and their absolute URLs in menu_breadcrumb_schema",
        "symfony/translation-contracts": "For the labels translated in menu_breadcrumb_schema, as the templates translate them",
        "twig/twig": "For menu, menu_breadcrumb, menu_breadcrumb_schema and the templates"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\MenuBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\MenuBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
