{
    "name": "phil/product-bundles",
    "description": "Sell products as one bundle: fixed or discounted price, stock set by the scarcest part, cost composed from its parts, whole returns, bundles shared by sellers.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "product-bundles",
        "bundle",
        "kit",
        "commerce",
        "composed-cost",
        "cooperative-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/money": "^0.1@dev",
        "phil/pricing": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "phil/commerce-catalog-bundle": "To read the prices of the components from the catalogue, through the ComponentPrices port",
        "phil/commerce-logistics-bundle": "To read the stock and the unit cost of the components, through the ComponentStock and ComponentCosts ports"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\ProductBundles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\ProductBundles\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
