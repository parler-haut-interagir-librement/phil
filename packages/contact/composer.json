{
    "name": "phil/contact",
    "description": "Contact cards for PHP: a person or an organisation with a structured name ordered and sorted by its culture, emails, typed phone lines, web addresses and messaging handles, written as vCard 4.0, schema.org JSON-LD and JSContact, read from JSContact, and kept as an array for one JSON column",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "contact",
        "jscontact",
        "person-name",
        "vcard",
        "schema.org",
        "json-ld",
        "value-object"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-filter": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "phil/address": "^0.1@dev",
        "phil/enums": "^0.3@dev",
        "phil/instant-messenger": "^0.1@dev",
        "phil/phone": "^0.1@dev",
        "phil/url": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Contact\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Contact\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
