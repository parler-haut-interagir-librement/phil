{
    "name": "phil/directory-bundle",
    "description": "A directory for Symfony: listings in genres, each a content of phil/content-bundle whose versions keep its history, written by their author and the editors the author names, and related across genres as the configuration says, each found as its author decides: listed, kept out of search engines, or unlisted",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "directory",
        "listing",
        "content",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "doctrine/orm": "^3.7",
        "phil/address": "^0.1@dev",
        "phil/address-bundle": "^0.1@dev",
        "phil/contact": "^0.1@dev",
        "phil/contact-bundle": "^0.1@dev",
        "phil/content-bundle": "^0.1@dev",
        "phil/ddd-bundle": "^0.1@dev",
        "phil/geo": "^0.1@dev",
        "phil/geo-bundle": "^0.1@dev",
        "phil/indexing-consent": "^0.1@dev",
        "phil/locale-dimensions": "^0.1@dev",
        "phil/sitemap": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/form": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/security-core": "^8.2",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/browser-kit": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/dom-crawler": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\DirectoryBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\DirectoryBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
