{% extends layout %}

{% block title %}{{ ('guest.confirm.title.' ~ kind)|trans({}, 'phil_privacy') }}{% endblock %}

{% block content %}
    <h1>{{ ('guest.confirm.title.' ~ kind)|trans({}, 'phil_privacy') }}</h1>
    {% if incomplete %}<p role="alert">{{ 'guest.confirm.incomplete'|trans({}, 'phil_privacy') }}</p>{% endif %}
    <p>{{ ('guest.confirm.intro.' ~ kind)|trans({}, 'phil_privacy') }}</p>

    <form method="post" action="{{ path('phil_privacy_guest_confirm', {id: id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="token" value="{{ token }}">
        <input type="hidden" name="kind" value="{{ kind }}">
        <button type="submit">{{ ('guest.confirm.submit.' ~ kind)|trans({}, 'phil_privacy') }}</button>
    </form>
{% endblock %}
