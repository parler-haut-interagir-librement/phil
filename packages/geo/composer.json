{
    "name": "phil/geo",
    "description": "Geographic value types for PHP: coordinates in decimal degrees, great-circle distances, bounding boxes, and coordinates blurred to publish a place without its exact position",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "geo",
        "coordinates",
        "distance",
        "haversine",
        "value-object"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-filter": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/cache": "^8.2",
        "symfony/cache-contracts": "^3.6",
        "symfony/http-client": "^8.2",
        "symfony/http-client-contracts": "^3.6"
    },
    "suggest": {
        "symfony/cache": "For CachedGeocoder",
        "symfony/http-client": "For the HTTP geocoding adapters and IpstackLocator"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Geo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Geo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
