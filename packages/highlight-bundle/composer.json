{
    "name": "phil/highlight-bundle",
    "description": "phil/highlight in Symfony: the highlighter with the application's languages and aliases, the code blocks of UJO documents coloured on the server, the highlight Twig filter, and a theme stylesheet",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "syntax-highlighting",
        "highlighter",
        "code",
        "twig",
        "ujo",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/highlight": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2"
    },
    "require-dev": {
        "phil/ujo": "^0.1@dev",
        "phil/ujo-bundle": "^0.1@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/asset-mapper": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/form": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/validator": "^8.2",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "phil/ujo-bundle": "For the code blocks of UJO documents coloured on the server",
        "symfony/asset-mapper": "For the theme stylesheet, mapped as phil-highlight/highlight.css",
        "twig/twig": "For the highlight filter"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\HighlightBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\HighlightBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
