{
    "name": "phil/typography",
    "description": "Real quotation marks, dashes, French spaces and hyphenation in your HTML, in every language, without breaking the markup.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "typography",
        "hyphenation",
        "smart-quotes",
        "microtypography",
        "html5"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "ext-ctype": "*",
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Typography\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Typography\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
