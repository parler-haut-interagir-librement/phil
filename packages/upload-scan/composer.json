{
    "name": "phil/upload-scan",
    "description": "Pass every uploaded file through an antivirus before anyone opens it: clean, infected or not scanned, with ClamAV built in and a policy for files not scanned.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "antivirus",
        "clamav",
        "clamd",
        "upload",
        "malware"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\UploadScan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\UploadScan\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
