{# The email of the message login_link: a greeting, what the link does and how long it lasts, the link. #}
{% set d = 'phil_identity_provider' %}
<p>{{ name is not null ? 'email.greeting_name'|trans({'%name%': name}, d) : 'email.greeting'|trans({}, d) }}</p>
<p>{{ 'email.login_link.body'|trans({'%site%': site}, d) }}</p>
<p><a href="{{ url }}">{{ 'email.login_link.action'|trans({}, d) }}</a></p>
<p>{{ 'email.ignore'|trans({}, d) }}</p>
