{
    "name": "phil/shifts-bundle",
    "description": "Volunteer shifts in Symfony: rosters and a swap board stored with Doctrine, volunteer and coordinator pages, a shift form, Twig components, Messenger.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "shifts",
        "volunteers",
        "scheduling",
        "roster",
        "swap-board",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.6",
        "phil/shifts": "^0.1@dev",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/security-core": "^8.2",
        "symfony/security-csrf": "^8.2",
        "symfony/uid": "^8.2",
        "twig/twig": "^3.31.1"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/orm": "^3.8",
        "phil/privacy-bundle": "^0.3@dev",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/console": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/dom-crawler": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/event-dispatcher-contracts": "^3.8",
        "symfony/form": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/messenger": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/security-bundle": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/ux-twig-component": "^3.8"
    },
    "suggest": {
        "doctrine/orm": "To add the tables to the schema the ORM generates, for doctrine:migrations:diff",
        "phil/privacy-bundle": "For the shifts and swaps of a volunteer in the export and the erasure of their data",
        "symfony/console": "For phil:shifts:import",
        "symfony/form": "For the coordinators' form of a shift, which the pages require",
        "symfony/messenger": "To allocate the places among the interested in a worker",
        "symfony/security-bundle": "For the pages, which know the person signed in and check the voters",
        "symfony/ux-twig-component": "For the components <twig:PhilShifts:ShiftCard> and <twig:PhilShifts:MyShifts>"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\ShiftsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\ShiftsBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
