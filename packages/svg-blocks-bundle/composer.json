{
    "name": "phil/svg-blocks-bundle",
    "description": "Math, Mermaid, chart and QR code blocks in Symfony: drawn once and signed, rendered in documents, with a live preview and diagrams drawn in the background.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "ujo",
        "svg",
        "mathml",
        "mermaid",
        "qr-code",
        "chart",
        "stimulus",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/latex-mathml": "^0.1@dev",
        "phil/qr-code": "^0.1@dev",
        "phil/svg-blocks": "^0.1@dev",
        "phil/svg-chart": "^0.1@dev",
        "phil/svg-sanitizer": "^0.1@dev",
        "phil/ujo": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2"
    },
    "require-dev": {
        "phil/block-editor-bundle": "^0.1@dev",
        "phil/ujo-bundle": "^0.1@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/asset-mapper": "^8.2",
        "symfony/browser-kit": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/form": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/messenger": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/security-csrf": "^8.2",
        "symfony/validator": "^8.2"
    },
    "suggest": {
        "phil/block-editor-bundle": "For the documents of the block editor's field drawn when submitted",
        "phil/ujo-bundle": "For the documents of UJO fields drawn when submitted, and rendered from their drawings",
        "symfony/asset-mapper": "For the preview controller, served without a build step",
        "symfony/form": "For the documents of form fields drawn when submitted",
        "symfony/http-client": "For the diagrams drawn by the Mermaid service",
        "symfony/http-foundation": "For the preview endpoint",
        "symfony/messenger": "For the diagrams drawn in the background",
        "symfony/security-csrf": "For the preview endpoint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\SvgBlocksBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\SvgBlocksBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
