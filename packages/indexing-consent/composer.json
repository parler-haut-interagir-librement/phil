{
    "name": "phil/indexing-consent",
    "description": "The reach of a public record as the person it is about decides it: listed, kept out of search engines, or unlisted, asked by the sitemap, the structured data and the listings of a site",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "privacy",
        "de-indexing",
        "robots",
        "noindex",
        "sitemap"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\IndexingConsent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\IndexingConsent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
