{
    "name": "@phil/reviews-bundle",
    "description": "The helpfulness controller of phil/reviews-bundle: a vote sent in the background, the counts written again without leaving the page",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "main": "src/helpful_controller.js",
    "symfony": {
        "controllers": {
            "helpful": {
                "main": "src/helpful_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0"
    }
}
