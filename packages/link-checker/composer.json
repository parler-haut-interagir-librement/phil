{
    "name": "phil/link-checker",
    "description": "Find the dead links in a site's content before readers do: each address checked once, paced per host, anchors verified, private networks refused.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "link-checker",
        "broken-links",
        "dead-links",
        "content",
        "anchors"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-uri": "*",
        "phil/safe-http": "^0.2@dev",
        "phil/url": "^0.1@dev",
        "symfony/cache-contracts": "^3.6",
        "symfony/clock": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/http-client-contracts": "^3.6",
        "symfony/service-contracts": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/cache": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\LinkChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\LinkChecker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
