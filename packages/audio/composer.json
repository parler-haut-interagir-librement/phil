{
    "name": "phil/audio",
    "description": "Audio for PHP: transcoding, metadata, waveforms computed once on the server, excerpts, the creator's listening policy, and chapters and transcripts.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "audio",
        "ffmpeg",
        "waveform",
        "transcoding",
        "podcast"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "phil/timed-text": "^0.1@dev",
        "phil/url": "^0.1@dev",
        "symfony/process": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Audio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Audio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
