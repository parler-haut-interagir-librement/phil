{% extends '@PhilNewsletter/pages/layout.html.twig' %}

{% block body %}
    {% if done is defined %}
        <h1>{{ 'unsubscribe.done'|trans({}, 'phil_newsletter') }}</h1>
    {% else %}
        <h1>{{ 'unsubscribe.title'|trans({}, 'phil_newsletter') }}</h1>
        <form method="post">
            {% if list is not null %}
                <fieldset>
                    <legend>{{ 'unsubscribe.scope'|trans({}, 'phil_newsletter') }}</legend>
                    <label><input type="radio" name="scope" value="list" checked> {{ 'unsubscribe.scope.list'|trans({'%list%': list.name}, 'phil_newsletter') }}</label>
                    <label><input type="radio" name="scope" value="all"> {{ 'unsubscribe.scope.all'|trans({}, 'phil_newsletter') }}</label>
                </fieldset>
            {% endif %}
            <fieldset>
                <legend>{{ 'unsubscribe.reason'|trans({}, 'phil_newsletter') }}</legend>
                {% for reason in reasons %}
                    <label><input type="radio" name="reason" value="{{ reason.value }}"> {{ ('reason.' ~ reason.value)|trans({}, 'phil_newsletter') }}</label>
                {% endfor %}
                <p>{{ 'unsubscribe.anonymous'|trans({}, 'phil_newsletter') }}</p>
            </fieldset>
            <button type="submit">{{ 'unsubscribe.button'|trans({}, 'phil_newsletter') }}</button>
        </form>
    {% endif %}
{% endblock %}
