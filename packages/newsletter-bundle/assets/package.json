{
    "name": "@phil/newsletter-bundle",
    "description": "The Markdown editor of a newsletter campaign: a toolbar and a preview laid out as the message, in a sandboxed frame",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "main": "src/markdown_editor_controller.js",
    "symfony": {
        "controllers": {
            "markdown-editor": {
                "main": "src/markdown_editor_controller.js",
                "webpackMode": "lazy",
                "fetch": "lazy",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0"
    }
}
