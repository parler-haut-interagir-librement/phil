{
    "name": "phil/participant-safety-info",
    "description": "Keep a participant's emergency contacts, allergies and needs for an event encrypted, readable only by its responsible people, each reading logged.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "safety",
        "emergency-contact",
        "events",
        "encryption",
        "privacy",
        "key-management"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/key-management": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\ParticipantSafetyInfo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\ParticipantSafetyInfo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
