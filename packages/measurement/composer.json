{
    "name": "phil/measurement",
    "description": "Store, convert and display units of measure exactly, temperatures included, with CLDR formats and the units each sales channel uses.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "units",
        "measurement",
        "conversion",
        "ucum",
        "cldr",
        "decimal"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Measurement\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Measurement\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
