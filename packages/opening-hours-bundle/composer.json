{
    "name": "phil/opening-hours-bundle",
    "description": "phil/opening-hours in Symfony: an opening hours form with a field a day and special hours, the JSON column type phil_opening_hours, and hours in Twig — open now, next opening, a localised table, schema.org",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "opening-hours",
        "business-hours",
        "schema.org",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "phil/opening-hours": "^0.1@dev",
        "psr/clock": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/form": "^8.2",
        "symfony/options-resolver": "^8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/clock": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/validator": "^8.2",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "doctrine/dbal": "For the phil_opening_hours column type",
        "symfony/clock": "Required with twig/twig: the Twig functions read now from the container's clock service, which FrameworkBundle registers once it is installed",
        "twig/twig": "For the opening_hours_* functions and the table template"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\OpeningHoursBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\OpeningHoursBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
