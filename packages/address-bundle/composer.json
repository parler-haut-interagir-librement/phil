{
    "name": "phil/address-bundle",
    "description": "phil/address in Symfony: an address form whose fields follow the country chosen, live through a Stimulus controller, the constraint ValidAddress, the JSON column type phil_address, and addresses in Twig",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "address",
        "address-form",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "phil/address": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/form": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/intl": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/translation-contracts": "^3.6",
        "symfony/validator": "^8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "doctrine/dbal": "For the phil_address column type",
        "symfony/routing": "For the format endpoint the Stimulus controller reads",
        "twig/twig": "For the address filters and the country_name and address_schema functions"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\AddressBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\AddressBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
