{
    "name": "phil/mime-reader",
    "description": "Read raw emails safely, even hostile ones: headers, nested MIME parts and report fields parsed within limits, bodies decoded on demand and converted to UTF-8.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "email",
        "mime",
        "rfc5322",
        "rfc2045",
        "rfc2047",
        "rfc2231",
        "parser"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\MimeReader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\MimeReader\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
