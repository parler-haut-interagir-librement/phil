{
    "name": "phil/follow-bundle",
    "description": "Let members follow a topic, thread, listing or member and hear about new activity once, through notifications, with levels, approval requests and mutuals.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "follow",
        "subscriptions",
        "notifications",
        "mutual",
        "activity",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "doctrine/dbal": "^4.5",
        "phil/notifications-bundle": "^0.4@dev",
        "psr/clock": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/security-csrf": "^8.2",
        "symfony/translation-contracts": "^3.6",
        "symfony/uid": "^8.2",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "phil/privacy-bundle": "^0.3@dev",
        "phpunit/phpunit": "^13.4",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/browser-kit": "^8.2",
        "symfony/cache": "^8.2",
        "symfony/cache-contracts": "^3.6",
        "symfony/clock": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/dom-crawler": "^8.1",
        "symfony/event-dispatcher": "^8.2",
        "symfony/event-dispatcher-contracts": "^3.6",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/lock": "^8.2",
        "symfony/messenger": "^8.2",
        "symfony/notifier": "^8.2",
        "symfony/scheduler": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bundle": "^8.2"
    },
    "suggest": {
        "doctrine/orm": "To add the tables to the schema the ORM generates, for doctrine:migrations:diff",
        "phil/privacy-bundle": "For a member's follows, requests and relationships in the export and the erasure of their data",
        "symfony/cache-contracts": "To keep the last run of the schedule in a cache pool",
        "symfony/lock": "To keep the schedule to one worker",
        "symfony/messenger": "To send activities to their followers in the background, a page at a time",
        "symfony/scheduler": "To purge the activities, claims and marks every day"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\FollowBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\FollowBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
