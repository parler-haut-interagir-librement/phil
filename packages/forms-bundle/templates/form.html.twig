{#
    The page of a form as the bundle renders it; an application gives its own, extending its layout and including
    '@PhilForms/_form.html.twig', with the key template.
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ definition.title }}</title>
</head>
<body>
    <h1>{{ definition.title }}</h1>
    {{ include('@PhilForms/_form.html.twig') }}
</body>
</html>
