{#- An entry as its form's recipients read it. `entry` is the Entry, `fields` the fields asked; a sensitive value is withheld. -#}
<p><strong>{{ 'phil_forms.email_intro'|trans({'%form%': entry.form.title}, 'phil_forms') }}</strong></p>
<dl>
{%- for field in fields %}
    {%- set value = entry.values[field.name] ?? null %}
    <dt>{{ field.label }}</dt>
    <dd>{% if field.sensitive %}{{ 'phil_forms.withheld'|trans({}, 'phil_forms') }}{% elseif value is same as(true) %}{{ 'phil_forms.yes'|trans({}, 'phil_forms') }}{% elseif value is same as(false) %}{{ 'phil_forms.no'|trans({}, 'phil_forms') }}{% elseif value is null %}—{% else %}{{ value|nl2br }}{% endif %}</dd>
{%- endfor %}
</dl>
