{
    "name": "phil/commerce-catalog-bundle",
    "description": "Products, variants and price books for a Symfony shop on phil/commerce-bundle: families, composites, translated names, categories, pay what you want.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "catalog",
        "products",
        "variants",
        "commerce",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.6",
        "doctrine/orm": "^3.8",
        "phil/commerce-bundle": "^0.5@dev",
        "phil/ddd-bundle": "^0.1@dev || ^0.2@dev",
        "phil/doctrine-behaviours": "^0.3@dev",
        "phil/locale-dimensions": "^0.1@dev",
        "phil/money": "^0.1@dev",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/polyfill-php86": "^1.43",
        "symfony/translation-contracts": "^3.8"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/persistence": "^4.2",
        "phil/commerce-logistics-bundle": "^0.2@dev",
        "phil/product-feeds": "^0.1@dev",
        "phil/resource": "^0.1@dev",
        "phil/taxonomy-bundle": "^0.2@dev",
        "phil/url": "^0.1.3@dev",
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/event-dispatcher-contracts": "^3.8",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/messenger": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/yaml": "^8.2"
    },
    "conflict": {
        "phil/commerce-logistics-bundle": "<0.1.1"
    },
    "suggest": {
        "phil/commerce-logistics-bundle": "To read the cost of products, a composite's the sum of its parts', from the value of the stock (0.2 or later)",
        "phil/commerce-promotions-bundle": "For promotions on the products: a share off, an amount off, N for X, bundle prices, free shipping",
        "phil/product-feeds": "For the catalogue published as feed files for comparison sites and marketplaces",
        "phil/taxonomy-bundle": "For the products filed in categories and tags shared with the rest of the site",
        "symfony/http-foundation": "For the product feeds served by the route of config/routes.php, with their cache headers",
        "symfony/messenger": "For the product feeds published by a message, which a schedule of Symfony Scheduler sends"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CommerceCatalogBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CommerceCatalogBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
