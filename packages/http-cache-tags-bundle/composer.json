{
    "name": "phil/http-cache-tags-bundle",
    "description": "HTTP cache tags for Symfony: gathered while a response is rendered, written for Varnish, Cloudflare or Fastly, and purged when an entity changes",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "cache-tags",
        "cloudflare",
        "http-cache",
        "symfony-bundle",
        "varnish"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-kernel": "^8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/http-client-contracts": "^3.6",
        "symfony/http-foundation": "^8.2",
        "symfony/messenger": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "doctrine/orm": "To invalidate the tags of the entities a flush changes",
        "psr/log": "To log a purge the cache refused rather than throw it",
        "symfony/http-client": "To purge Varnish or Cloudflare",
        "symfony/messenger": "To purge the tags a worker's message gathers once it is handled",
        "twig/twig": "For cache_tag()"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\HttpCacheTagsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\HttpCacheTagsBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
