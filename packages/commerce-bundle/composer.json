{
    "name": "phil/commerce-bundle",
    "description": "The core of a Symfony store: orders, prices, taxes, payments and receipts with their PDF invoices, on which separate modules plug to sell more kinds of things.",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/orm": "^3.7",
        "phil/ddd-bundle": "^0.1@dev",
        "phil/money": "^0.1@dev",
        "phil/paged-media": "^0.1@dev",
        "phil/tax": "^0.1@dev",
        "psr/clock": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/event-dispatcher-contracts": "^3.6",
        "symfony/http-foundation": "^8.2",
        "symfony/uid": "^8.2",
        "symfony/workflow": "^8.2"
    },
    "require-dev": {
        "ext-zlib": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/persistence": "^4.1",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/clock": "^8.2",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CommerceBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CommerceBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
