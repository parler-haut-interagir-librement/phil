{
    "name": "phil/editorial-calendar",
    "description": "Plans publications ahead: items by content, language and author through their workflow, all-or-nothing batches, calendar views, conflicts and gaps, iCalendar.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "editorial-calendar",
        "publishing",
        "scheduling",
        "icalendar",
        "content"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/resource": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\EditorialCalendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\EditorialCalendar\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
