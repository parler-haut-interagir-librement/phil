{
    "name": "phil/commerce-subscription-bundle",
    "description": "Subscriptions in Symfony on phil/commerce-bundle: tiers, billing periods, trials, renewal and dunning, proration, gifts, seats, the features each tier unlocks.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "subscription",
        "recurring",
        "tiers",
        "proration",
        "gift",
        "commerce",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "doctrine/dbal": "^4.5",
        "doctrine/orm": "^3.7",
        "phil/address": "^0.1@dev",
        "phil/commerce-bundle": "^0.5@dev",
        "phil/ddd-bundle": "^0.1@dev",
        "phil/money": "^0.1@dev",
        "psr/clock": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/uid": "^8.2"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/persistence": "^4.1",
        "phil/privacy-bundle": "^0.3@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/clock": "^8.2",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/lock": "^8.2",
        "symfony/scheduler": "^8.2"
    },
    "suggest": {
        "phil/privacy-bundle": "For the delivery addresses in the export and the erasure of a subscriber's data",
        "symfony/console": "For the command that purges the delivery addresses past their retention",
        "symfony/lock": "To run the scheduled purge and the command once at a time across workers",
        "symfony/scheduler": "For the recurring purge of the delivery addresses past their retention"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CommerceSubscriptionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CommerceSubscriptionBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
