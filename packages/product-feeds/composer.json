{
    "name": "phil/product-feeds",
    "description": "Product feeds for comparison sites and marketplaces: a catalogue written, in constant memory, to an RSS 2.0 file in the g: namespace of product data or a TSV file, and swapped into place whole",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "product-feed",
        "merchant",
        "rss",
        "tsv",
        "commerce"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/money": "^0.1@dev",
        "phil/url": "^0.1.4@dev"
    },
    "require-dev": {
        "ext-dom": "*",
        "ext-libxml": "*",
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\ProductFeeds\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\ProductFeeds\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
