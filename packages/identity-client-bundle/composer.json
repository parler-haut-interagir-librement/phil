{
    "name": "phil/identity-client-bundle",
    "description": "OpenID Connect sign-in for Symfony on the native oidc_login authenticator: one semantic configuration, sub-indexed provisioning, validated return_to, replay-guarded back-channel logout, a session cap, step-up by acr_values and max_age, and serialized token refresh",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "back-channel-logout",
        "oidc",
        "openid-connect",
        "step-up",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "ext-uri": "*",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/cache": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/lock": "^8.2",
        "symfony/security-bundle": "^8.2",
        "symfony/security-core": "^8.2",
        "symfony/security-http": "^8.2",
        "web-token/jwt-library": "^4.2"
    },
    "require-dev": {
        "phpbench/phpbench": "^1.4",
        "phpunit/phpunit": "^13.4",
        "psr/container": "^2.0",
        "symfony/browser-kit": "^8.2",
        "symfony/http-client-contracts": "^3.6",
        "symfony/routing": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\IdentityClientBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\IdentityClientBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
