{
    "name": "phil/licensing-bundle",
    "description": "Credit every work under its license, from Creative Commons to the ORC and OGL: attribution pages, compliance checks and an export guard before printing.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "licensing",
        "license",
        "attribution",
        "creative-commons",
        "orc-license",
        "open-game-license",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "doctrine/orm": "^3.8",
        "phil/url": "^0.1.4@dev",
        "psr/event-dispatcher": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/translation-contracts": "^3.8",
        "symfony/uid": "^8.2",
        "twig/twig": "^3.31.1"
    },
    "require-dev": {
        "doctrine/dbal": "^4.6",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/persistence": "^4.2",
        "phil/paged-media": "^0.1@dev",
        "phil/paged-media-bundle": "^0.1.1@dev",
        "phil/structured-data": "^0.1.1@dev",
        "phil/ujo": "^0.1.3@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "roave/security-advisories": "dev-latest",
        "symfony/form": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/security-bundle": "^8.2",
        "symfony/security-core": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/validator": "^8.2",
        "symfony/yaml": "^8.2"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "For the declarations kept in the table phil_licensing_declaration",
        "phil/paged-media-bundle": "For the export guard run before each print that names its work",
        "phil/structured-data": "For the licensing of a work as JSON-LD",
        "phil/ujo": "For the license and attribution page as a UJO (Universal JSON Output) document",
        "symfony/form": "For the attribution form and the license finder in steps, with symfony/validator",
        "symfony/security-bundle": "For the voter PHIL_LICENSING_EXPORT",
        "symfony/translation": "For the page and the messages in English and French",
        "symfony/twig-bundle": "For the license and attribution page as HTML",
        "symfony/validator": "For the checks of the attribution form and of the license finder"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\LicensingBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\LicensingBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
