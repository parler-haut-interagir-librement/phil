{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% if collector.renders is not empty or collector.storage is not empty %}
        {% set icon %}
            <span class="sf-toolbar-value">{{ collector.renders|length }}</span>
            <span class="sf-toolbar-label">renderings</span>
        {% endset %}
        {% set text %}
            <div class="sf-toolbar-info-piece"><b>Rendered</b> <span>{{ collector.renders|length }} in {{ collector.renderTime|number_format(1) }} ms</span></div>
            <div class="sf-toolbar-info-piece"><b>Read back</b> <span>{{ collector.hits }}</span></div>
            <div class="sf-toolbar-info-piece"><b>Storage operations</b> <span>{{ collector.storage|length }}</span></div>
        {% endset %}
        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: true}) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label{{ collector.renders is empty and collector.storage is empty ? ' disabled' }}">
        <strong>Media</strong>
        <span class="count"><span>{{ collector.renders|length }}</span></span>
    </span>
{% endblock %}

{% block panel %}
    <h2>Renderings</h2>
    {% if collector.renders is empty %}
        <div class="empty"><p>No image was rendered during this request.</p></div>
    {% else %}
        <table>
            <thead><tr><th>Format</th><th>Type</th><th>Bytes</th><th>Time (ms)</th></tr></thead>
            <tbody>
            {% for render in collector.renders %}
                <tr><td>{{ render.format }}</td><td>{{ render.type }}</td><td>{{ render.bytes }}</td><td>{{ render.milliseconds|number_format(1) }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h2>Storage</h2>
    {% if collector.storage is empty %}
        <div class="empty"><p>The storage was not used during this request.</p></div>
    {% else %}
        <table>
            <thead><tr><th>Operation</th><th>Key</th><th>Bytes</th><th>Found</th></tr></thead>
            <tbody>
            {% for entry in collector.storage %}
                <tr><td>{{ entry.operation }}</td><td><code>{{ entry.key }}</code></td><td>{{ entry.bytes }}</td><td>{{ entry.operation == 'read' ? (entry.found ? 'yes' : 'no') : '—' }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
