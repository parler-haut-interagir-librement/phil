{
    "name": "phil/lti",
    "description": "LTI 1.3 for PHP, on both sides: a tool that learning platforms launch, and a platform that launches tools, with Deep Linking and the LTI Advantage services.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "lti",
        "lti-advantage",
        "deep-linking",
        "ags",
        "nrps",
        "e-learning"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "phil/safe-http": "^0.2.1@dev",
        "phil/url": "^0.1.4@dev",
        "psr/clock": "^1.0",
        "symfony/cache-contracts": "^3.6",
        "symfony/service-contracts": "^3.6",
        "web-token/jwt-library": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/cache": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/http-client": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Lti\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Lti\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
