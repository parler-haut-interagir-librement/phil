{
    "name": "phil/access-links",
    "description": "Invite people by personal link: one secret link per recipient, an answer they can change until the closing date, and reminders to those who have not answered.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "invitations",
        "personal-link",
        "rsvp",
        "reminders",
        "token",
        "hmac"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "phil/url": "^0.1@dev",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/clock": "^8.2",
        "symfony/messenger": "^8.2"
    },
    "suggest": {
        "doctrine/dbal": "To keep the invitations and the link hashes in a database with DbalInvitationStore",
        "symfony/messenger": "To send the reminders as messages, with ReminderDispatcher and SendInvitationReminderHandler"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\AccessLinks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\AccessLinks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
