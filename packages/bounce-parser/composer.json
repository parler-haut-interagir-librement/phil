{
    "name": "phil/bounce-parser",
    "description": "Know what every message in your bounce mailbox says and what to do about the address it names: bounces, automatic replies and abuse reports, classified.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "email",
        "bounce",
        "dsn",
        "arf",
        "feedback-loop",
        "auto-reply",
        "verp",
        "mime"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\BounceParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\BounceParser\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
