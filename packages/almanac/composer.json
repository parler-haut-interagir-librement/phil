{
    "name": "phil/almanac",
    "description": "Easter, Moon phases, seasons, eclipses, sunrise and sunset, and dates written in words such as \"2nd monday of october\", computed for any year.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "calendar",
        "easter",
        "moon-phases",
        "equinox",
        "solstice",
        "eclipse",
        "sunrise",
        "twilight",
        "chinese-new-year",
        "holidays"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/recurrence": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Almanac\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Almanac\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
