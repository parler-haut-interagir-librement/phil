{
    "name": "phil/outbox-bundle",
    "description": "phil/outbox in Symfony: events saved in a table of your Doctrine connection, delivered by a command or the Scheduler, with retries and a Messenger bridge.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "outbox",
        "transactional-outbox",
        "events",
        "doctrine",
        "worker",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.6",
        "phil/outbox": "^0.2@dev",
        "psr/event-dispatcher": "^1.0",
        "symfony/clock": "^8.2",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2"
    },
    "require-dev": {
        "ext-pdo": "*",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/orm": "^3.8",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/lock": "^8.2",
        "symfony/messenger": "^8.2",
        "symfony/scheduler": "^8.2"
    },
    "suggest": {
        "doctrine/orm": "To add the outbox table to the schema the ORM generates",
        "symfony/console": "For phil:outbox:relay, phil:outbox:schema, phil:outbox:purge and the commands of the dead records",
        "symfony/lock": "For one run of the relay at a time",
        "symfony/messenger": "To relay the events to a Messenger bus, and for the scheduled trigger",
        "symfony/scheduler": "For the scheduled trigger of the relay"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\OutboxBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\OutboxBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
