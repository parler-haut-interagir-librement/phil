{
    "name": "phil/passwords",
    "description": "Tell people how guessable their password is, refuse the ones already leaked through Pwned Passwords, and generate strong passwords and passphrases.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "password",
        "password-strength",
        "zxcvbn",
        "pwned-passwords",
        "k-anonymity",
        "passphrase",
        "password-generator",
        "validator"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/http-client": "^8.2",
        "symfony/http-client-contracts": "^3.8",
        "symfony/validator": "^8.2"
    },
    "suggest": {
        "symfony/http-client": "For PwnedPasswordsSource, the breach source of the Pwned Passwords range API",
        "symfony/validator": "For the MinimumStrength and NotCompromised constraints"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Passwords\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Passwords\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
