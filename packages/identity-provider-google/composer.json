{
    "name": "phil/identity-provider-google",
    "description": "Let people sign in with Google and link it to their account safely: Google sign-in for phil/identity-provider-bundle, with Cross-Account Protection events.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "google",
        "sign-in-with-google",
        "openid-connect",
        "oidc",
        "risc",
        "cross-account-protection",
        "shared-signals",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "phil/identity-provider-bundle": "^0.3@dev || ^0.4@dev",
        "phil/safe-http": "^0.2.1@dev",
        "phil/url": "^0.1.4@dev",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/http-client-contracts": "^3.6",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/security-core": "^8.2",
        "symfony/security-http": "^8.2",
        "symfony/service-contracts": "^3.6",
        "web-token/jwt-library": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/cache": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/event-dispatcher": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\IdentityProviderGoogle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\IdentityProviderGoogle\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
