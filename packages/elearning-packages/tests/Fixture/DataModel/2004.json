{
    "version": "2004",
    "dataModelVersion": "1.0",
    "elements": {
        "cmi.comments_from_learner.n.comment": {
            "access": "rw",
            "pattern": "^(?:(?!\\{lang=)[\\s\\S]*|\\{lang=[A-Za-z]{1,8}(?:-[A-Za-z0-9]{1,8})*\\}[\\s\\S]*)$",
            "maxChars": 4000
        },
        "cmi.comments_from_learner.n.location": {
            "access": "rw",
            "maxChars": 250
        },
        "cmi.comments_from_learner.n.timestamp": {
            "access": "rw",
            "pattern": "^(?:19[7-9]\\d|20[0-2]\\d|203[0-8])(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01])(?:T(?:[01]\\d|2[0-3])(?::[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,2})?)?)?(?:Z|[+-](?:[01]\\d|2[0-3])(?::?[0-5]\\d)?)?)?)?)?$"
        },
        "cmi.comments_from_lms.n.comment": {
            "access": "ro",
            "pattern": "^(?:(?!\\{lang=)[\\s\\S]*|\\{lang=[A-Za-z]{1,8}(?:-[A-Za-z0-9]{1,8})*\\}[\\s\\S]*)$",
            "maxChars": 4000
        },
        "cmi.comments_from_lms.n.location": {
            "access": "ro",
            "maxChars": 250
        },
        "cmi.comments_from_lms.n.timestamp": {
            "access": "ro",
            "pattern": "^(?:19[7-9]\\d|20[0-2]\\d|203[0-8])(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01])(?:T(?:[01]\\d|2[0-3])(?::[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,2})?)?)?(?:Z|[+-](?:[01]\\d|2[0-3])(?::?[0-5]\\d)?)?)?)?)?$"
        },
        "cmi.completion_status": {
            "access": "rw",
            "pattern": "^(?:completed|incomplete|not attempted|unknown)$",
            "default": "unknown"
        },
        "cmi.completion_threshold": {
            "access": "ro",
            "pattern": "^-?(?:\\d{1,15}(?:\\.\\d{0,15})?|\\.\\d{1,15})$",
            "maxChars": 40,
            "min": 0.0,
            "max": 1.0
        },
        "cmi.credit": {
            "access": "ro",
            "pattern": "^(?:credit|no-credit)$",
            "default": "credit"
        },
        "cmi.entry": {
            "access": "ro",
            "pattern": "^(?:ab-initio|resume|)$",
            "default": ""
