        "cmi.exit": {
            "access": "wo",
            "pattern": "^(?:time-out|suspend|logout|normal|)$"
        },
        "cmi.interactions.n.id": {
            "access": "rw",
            "pattern": "^(?:(?![Uu][Rr][Nn]:)\\S+|[Uu][Rr][Nn]:[A-Za-z0-9][A-Za-z0-9-]{0,31}:\\S+)$",
            "maxChars": 4000
        },
        "cmi.interactions.n.type": {
            "access": "rw",
            "pattern": "^(?:true-false|choice|fill-in|long-fill-in|likert|matching|performance|sequencing|numeric|other)$"
        },
        "cmi.interactions.n.objectives.n.id": {
            "access": "rw",
            "pattern": "^(?:(?![Uu][Rr][Nn]:)\\S+|[Uu][Rr][Nn]:[A-Za-z0-9][A-Za-z0-9-]{0,31}:\\S+)$",
            "maxChars": 4000
        },
        "cmi.interactions.n.timestamp": {
            "access": "rw",
            "pattern": "^(?:19[7-9]\\d|20[0-2]\\d|203[0-8])(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01])(?:T(?:[01]\\d|2[0-3])(?::[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,2})?)?)?(?:Z|[+-](?:[01]\\d|2[0-3])(?::?[0-5]\\d)?)?)?)?)?$"
        },
        "cmi.interactions.n.correct_responses.n.pattern": {
            "access": "rw",
            "maxChars": 4000,
