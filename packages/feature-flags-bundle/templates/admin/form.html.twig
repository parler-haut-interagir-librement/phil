{% extends layout %}

{% set creating = revision is null %}

{% block title %}{{ creating ? 'New flag' : form.name }} — Feature flags{% endblock %}

{% block content %}
    <p><a href="{{ path('phil_feature_flags_admin_list') }}">All flags</a></p>

    <h1>{{ creating ? 'New flag' : 'Edit ' ~ form.name }}</h1>

    {% if error %}<p role="alert">{{ error }}</p>{% endif %}

    <form method="post" action="{{ creating ? path('phil_feature_flags_admin_create') : path('phil_feature_flags_admin_edit', {name: form.name}) }}">
        {% if creating %}
            <p>A new flag starts inactive; activate it from its page once it is created.</p>
            <label for="name">Name</label>
            <input id="name" name="name" value="{{ form.name }}" required maxlength="100" pattern="[a-z0-9]+([._\-][a-z0-9]+)*">
        {% else %}
            <input type="hidden" name="revision" value="{{ revision }}">
        {% endif %}

        <label for="description">Description</label>
        <input id="description" name="description" value="{{ form.description }}" maxlength="500">

        <label for="owner">Owner</label>
        <input id="owner" name="owner" value="{{ form.owner }}" maxlength="100">

        <label for="kind">Kind</label>
        <select id="kind" name="kind">
            {% for kind in ['']|merge(kinds) %}
                <option value="{{ kind }}"{% if kind == form.kind %} selected{% endif %}>{{ kind ?: '—' }}</option>
            {% endfor %}
        </select>

        <label for="expires_on">Expires on</label>
        <input id="expires_on" name="expires_on" type="date" value="{{ form.expires_on }}">

        <label for="definition">Rules and experiment (JSON)</label>
        <textarea id="definition" name="definition" rows="12" required>{{ form.definition }}</textarea>
        <p>
            Rules: <code>{"attribute": "tenant", "members": ["tenant-a"]}</code> or
            <code>{"attribute": "tenant", "percentage": 20}</code>.
            An A/B test: <code>"experiment": {"attribute": "tenant", "variants": {"control": 50, "treatment": 50}}</code>.
        </p>

        <label for="reason">Reason</label>
        <textarea id="reason" name="reason" required maxlength="1000"></textarea>

        <button type="submit">{{ creating ? 'Create' : 'Save' }}</button>
    </form>
{% endblock %}
