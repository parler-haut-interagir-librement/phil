{
    "name": "phil/content-warnings-bundle",
    "description": "phil/content-warnings in Symfony: the catalogue of warning themes from configuration, the JSON column type phil_content_warnings, fields for warnings and preferences, a folded display in Twig with a Stimulus controller, and a store of each member's preferences",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "content-warnings",
        "trigger-warnings",
        "accessibility",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "phil/content-warnings": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/form": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/service-contracts": "^3.6"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "doctrine/dbal": "For the phil_content_warnings column type",
        "symfony/http-foundation": "For SessionWarningPreferences, the default store of preferences",
        "twig/twig": "For the Twig functions and the folded display"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\ContentWarningsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\ContentWarningsBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
