{
    "name": "phil/profile-secure-input",
    "description": "One require for the PHIL packages that guard what users send a Symfony application: addresses, outgoing fetches, request rates, form spam and uploaded files.",
    "license": "MIT",
    "type": "metapackage",
    "keywords": [
        "profile",
        "metapackage",
        "security",
        "input-validation",
        "rate-limit",
        "anti-spam",
        "upload",
        "ssrf",
        "symfony"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/rate-limit-bundle": "^0.1",
        "phil/safe-http": "^0.2",
        "phil/spam-protection-bundle": "^0.2",
        "phil/upload-scan-bundle": "^0.1",
        "phil/url-bundle": "^0.1"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "phpunit/phpunit": "^13.4",
        "symfony/dependency-injection": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/security-csrf": "^8.2",
        "symfony/twig-bundle": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Phil\\Profile\\SecureInput\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
