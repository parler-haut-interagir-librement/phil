{
    "name": "phil/audio-bundle",
    "description": "phil/audio in Symfony: audio renditions and waveforms produced in the background, uploads, the creator's listening policy, and an accessible audio player.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "audio",
        "player",
        "waveform",
        "ffmpeg",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "phil/audio": "^0.1@dev",
        "phil/timed-text": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/messenger": "^8.2"
    },
    "require-dev": {
        "phil/media-bundle": "^0.2@dev",
        "phil/url": "^0.1@dev",
        "phil/ux-kit": ">=0.5.0-alpha <1.0",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/clock": "^8.2",
        "symfony/dom-crawler": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/ux-twig-component": "^3.8",
        "symfony/yaml": "^8.2",
        "twig/twig": "^3.31"
    },
    "conflict": {
        "phil/media-bundle": "<0.1.1"
    },
    "suggest": {
        "phil/media-bundle": "For uploads, and the local copies and storage of the jobs, the originals streamed into the copies (0.1.1 or later)",
        "phil/ux-kit": "For the recipe Button the player draws its links with, through the Symfony UX Toolkit",
        "symfony/ux-twig-component": "For the player component"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\AudioBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\AudioBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
