{
    "name": "@phil/audio-bundle",
    "description": "The Stimulus controller of phil/audio-bundle: the waveform of a track drawn in SVG, and its chapters and transcript in step with the browser's audio element",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "main": "src/player_controller.js",
    "symfony": {
        "controllers": {
            "player": {
                "main": "src/player_controller.js",
                "webpackMode": "lazy",
                "fetch": "lazy",
                "enabled": true,
                "autoimport": {
                    "@phil/audio-bundle/styles/audio-player.css": true
                }
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0"
    }
}
