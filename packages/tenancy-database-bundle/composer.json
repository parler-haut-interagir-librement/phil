{
    "name": "phil/tenancy-database-bundle",
    "description": "Give each tenant of a Symfony application its own database, or the shared one, chosen at each request, with migrations per database and tenants moved safely.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-bundle",
        "multi-tenancy",
        "doctrine",
        "database-per-tenant"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.5",
        "doctrine/persistence": "^4.1",
        "phil/ddd-bundle": "^0.1@dev",
        "phil/tenancy-bundle": "^0.1@dev",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/service-contracts": "^3.6"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "doctrine/collections": "^3.0",
        "doctrine/doctrine-bundle": "^3.3",
        "phpunit/phpunit": "^13.4",
        "symfony/cache": "^8.2",
        "symfony/console": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/messenger": "^8.2",
        "symfony/process": "^8.2",
        "symfony/routing": "^8.2"
    },
    "suggest": {
        "ext-pcntl": "To stop the running migrations when the migration command receives SIGINT or SIGTERM",
        "symfony/console": "For the commands that migrate every database, create a tenant's and move a tenant",
        "symfony/framework-bundle": "For the default pool of the suspended databases and tenants",
        "symfony/messenger": "To retry the messages of a suspended tenant later",
        "symfony/process": "To run the migration of each database in a process of its own"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\TenancyDatabaseBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\TenancyDatabaseBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
