{
    "name": "phil/commerce-reports-bundle",
    "description": "Know what sells and what sits on the shelf: gross and net sales by product, category, channel, location and cashier, sell-through and dead stock reports.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "commerce",
        "reporting",
        "sales",
        "inventory",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/commerce-bundle": "^0.5@dev",
        "phil/money": "^0.1@dev",
        "phil/reporting-bundle": "^0.1@dev || ^0.2@dev",
        "psr/clock": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2"
    },
    "require-dev": {
        "phil/commerce-logistics-bundle": "^0.1@dev",
        "phil/commerce-pos-bundle": "^0.1@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/clock": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2"
    },
    "suggest": {
        "phil/commerce-logistics-bundle": "To read the stock figures from the stock journal",
        "phil/commerce-pos-bundle": "To read the lines sold at the point of sale"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CommerceReportsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CommerceReportsBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
