{
    "name": "phil/reservation",
    "description": "Decide whether something can be booked, such as a room, a table, a person's time or equipment: capacity, hours, rules, free slots, refusals and reminders.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "reservation",
        "booking",
        "availability",
        "scheduling",
        "slots"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Reservation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Reservation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
