{
    "name": "phil/calendar-import",
    "description": "Keep a calendar in step with external iCalendar feeds: read by URL on a schedule, changes found, the last good state kept when a feed fails, editor edits kept.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "phil/recurrence": "^0.1@dev",
        "phil/safe-http": "^0.2@dev",
        "phil/url": "^0.1@dev",
        "psr/clock": "^1.0",
        "symfony/http-client-contracts": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2",
        "symfony/http-client": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CalendarImport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CalendarImport\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
