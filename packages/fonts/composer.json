{
    "name": "phil/fonts",
    "description": "Font metadata from TrueType, OpenType, collections, WOFF and WOFF2: names, weight, style, OS/2 embedding permissions, licence, variation axes; @font-face rules and a licence register per file, written from scratch",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "font",
        "truetype",
        "opentype",
        "woff",
        "woff2",
        "font-face",
        "licence"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "ext-brotli": "To read WOFF2 files, through Brotli::decompressor()"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Fonts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Fonts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
