{
    "name": "phil/console-bundle",
    "description": "Safer Symfony console commands: #[ForbidEnvironment] refusing a command in the listed kernel environments, #[ConfirmEnvironment] asking for the environment's name before it runs, a --timestamps option prefixing each output line with the time, a --debug-phil option printing the debug logs of selected channels, a duration and memory summary, and a lint command listing the guarded commands",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "console",
        "command",
        "environment",
        "confirmation",
        "timestamps",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "symfony/config": "^8.2",
        "symfony/console": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/service-contracts": "^3.6"
    },
    "require-dev": {
        "monolog/monolog": "^3.0",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "roave/security-advisories": "dev-latest",
        "symfony/clock": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/monolog-bundle": "^4.1",
        "symfony/stopwatch": "^8.2"
    },
    "suggest": {
        "monolog/monolog": "For the --debug-phil option, which prints the debug logs of selected channels"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\ConsoleBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\ConsoleBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
