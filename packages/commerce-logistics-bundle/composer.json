{
    "name": "phil/commerce-logistics-bundle",
    "description": "Stock, shipments and delivery for a Symfony shop on phil/commerce-bundle: every movement journaled, reservations, carriers' rates and labels, convention stock.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "inventory",
        "shipping",
        "shipping-labels",
        "stock",
        "purchase-orders",
        "serial-numbers",
        "print-on-demand",
        "commerce",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "doctrine/orm": "^3.8",
        "phil/commerce-bundle": "^0.5@dev",
        "phil/ddd-bundle": "^0.1@dev || ^0.2@dev",
        "phil/money": "^0.1@dev",
        "phil/url": "^0.1@dev",
        "psr/clock": "^1.0",
        "symfony/clock": "^8.2",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/event-dispatcher-contracts": "^3.8",
        "symfony/http-client-contracts": "^3.8",
        "symfony/polyfill-php86": "^1.43",
        "symfony/service-contracts": "^3.8",
        "symfony/uid": "^8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^4.6",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/persistence": "^4.2",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/http-kernel": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CommerceLogisticsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CommerceLogisticsBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
