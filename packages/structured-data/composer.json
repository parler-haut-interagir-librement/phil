{
    "name": "phil/structured-data",
    "description": "Help search engines understand your pages: the schema.org graph of a page built from typed nodes, merged by @id, checked, and printed safely as JSON-LD.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "schema.org",
        "json-ld",
        "structured-data",
        "seo",
        "rich-results"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "phil/url": "^0.1.3@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\StructuredData\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\StructuredData\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
