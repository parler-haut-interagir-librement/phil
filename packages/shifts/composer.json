{
    "name": "phil/shifts",
    "description": "Volunteer shifts without double bookings: fixed, task or duration shifts, sign-up, assignment or allocation by interest, a reserve and a swap board.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "shifts",
        "volunteers",
        "scheduling",
        "roster",
        "swap-board",
        "events"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Shifts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Shifts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
