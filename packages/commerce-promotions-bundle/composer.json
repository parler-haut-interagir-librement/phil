{
    "name": "phil/commerce-promotions-bundle",
    "description": "Promotions for a Symfony shop on phil/commerce-bundle: a share or amount off, N for X, bundle prices, free shipping, codes in batches, uses per customer.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "promotions",
        "discounts",
        "commerce",
        "free-shipping",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "doctrine/orm": "^3.7",
        "phil/commerce-bundle": "^0.2@dev || ^0.3@dev",
        "phil/commerce-catalog-bundle": "^0.1@dev",
        "phil/ddd-bundle": "^0.1@dev",
        "phil/doctrine-behaviours": "^0.2@dev || ^0.3@dev",
        "phil/locale-dimensions": "^0.1@dev",
        "phil/money": "^0.1@dev",
        "psr/clock": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/translation-contracts": "^3.6"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/persistence": "^4.1",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/clock": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2"
    },
    "suggest": {
        "phil/commerce-logistics-bundle": "For the delivery charges a free shipping waives"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CommercePromotionsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CommercePromotionsBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
