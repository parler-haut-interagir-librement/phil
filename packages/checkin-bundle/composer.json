{
    "name": "phil/checkin-bundle",
    "description": "phil/checkin in Symfony: the desk on the application's resolvers, check-ins kept by Doctrine, scan, manifest and synchronisation endpoints granted by the application's security behind a stateless CSRF token, and a Stimulus desk that keeps checking in offline from a manifest of keyed fingerprints",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "check-in",
        "attendance",
        "ticketing",
        "offline",
        "stimulus",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "doctrine/dbal": "^4.5",
        "phil/checkin": "^0.1@dev",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/expression-language": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/security-core": "^8.2",
        "symfony/security-csrf": "^8.2"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "php-webdriver/webdriver": "^1.16",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/asset-mapper": "^8.2",
        "symfony/browser-kit": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/event-dispatcher-contracts": "^3.6",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/panther": "^2.4",
        "symfony/routing": "^8.2"
    },
    "suggest": {
        "doctrine/orm": "To add the check-in table to the schema the ORM generates",
        "symfony/asset-mapper": "To serve the desk controller and its stylesheet without a build step",
        "symfony/event-dispatcher": "To dispatch CheckInRecorded to the listeners of the application",
        "symfony/routing": "For the endpoints, and their URLs given to the desk controller",
        "symfony/stimulus-bundle": "For the desk controller"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CheckinBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CheckinBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
