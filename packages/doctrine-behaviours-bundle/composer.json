{
    "name": "phil/doctrine-behaviours-bundle",
    "description": "phil/doctrine-behaviours in Symfony: timestamps, blame, soft delete, trees, translations, versions and more, switched on by configuration.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "doctrine",
        "timestampable",
        "blameable",
        "soft-delete",
        "tree",
        "sluggable",
        "workflow",
        "versioning",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "doctrine/doctrine-bundle": "^3.3",
        "phil/doctrine-behaviours": "^0.3@dev",
        "symfony/clock": "^8.2",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/orm": "^3.7",
        "phil/locale-dimensions": "^0.1@dev",
        "phil/privacy-bundle": "^0.1@dev",
        "phil/search-bundle": "^0.1@dev",
        "phil/slug": "^0.1@dev",
        "phil/slug-bundle": "^0.1@dev || ^0.2@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/security-core": "^8.2",
        "symfony/uid": "^8.2",
        "symfony/workflow": "^8.2",
        "symfony/yaml": "^8.2"
    },
    "suggest": {
        "phil/privacy-bundle": "For the blame and the owner in the access and erasure requests of a person",
        "phil/slug-bundle": "For the sluggable behaviour, its sluggers",
        "symfony/console": "For phil:doctrine-behaviours:strip-versions, which takes the personal fields out of the versions already written",
        "symfony/security-bundle": "For the blame and owner of the authenticated user, and the right to go back to a past version",
        "symfony/uid": "For the dated identifier, a UUID v7",
        "symfony/workflow": "For the publication state and its dates"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\DoctrineBehavioursBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\DoctrineBehavioursBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    }
}
