{
    "name": "phil/cors-bundle",
    "description": "Let browsers call your API from the origins you allow: per-path CORS rules for Symfony, preflight answered early, no wildcard with credentials.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "cors",
        "cross-origin",
        "preflight",
        "http",
        "security",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/browser-kit": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/routing": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CorsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CorsBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
