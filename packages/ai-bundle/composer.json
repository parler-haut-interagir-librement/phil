{
    "name": "phil/ai-bundle",
    "description": "Language-model tasks in Symfony on Symfony AI, with quotas, budgets and people's own keys, and a cost journal that never stores a prompt or an answer.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "ai",
        "llm",
        "symfony-ai",
        "prompt",
        "quota",
        "byok",
        "image-generation",
        "text-to-speech",
        "streaming",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "doctrine/collections": "^3.1",
        "doctrine/orm": "^3.8",
        "phil/creation-disclosure": "^0.1@dev",
        "phil/url": "^0.1@dev",
        "phil/usage-meter": "^0.1@dev",
        "psr/clock": "^1.0",
        "symfony/ai-platform": "^0.15",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-client-contracts": "^3.8",
        "symfony/translation-contracts": "^3.8",
        "symfony/uid": "^8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^4.6",
        "doctrine/doctrine-bundle": "^3.4",
        "phil/privacy-bundle": "^0.3@dev",
        "phil/user-secrets-bundle": "^0.1@dev",
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/key-management": "^8.2",
        "symfony/lock": "^8.2",
        "symfony/process": "^8.2",
        "symfony/semaphore": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/yaml": "^8.2"
    },
    "suggest": {
        "phil/privacy-bundle": "For the journal in the export and the erasure of a subject's data",
        "phil/user-secrets-bundle": "To run a person's tasks on their own key",
        "symfony/http-client": "For the Replicate image platform, ReplicatePlatformFactory",
        "symfony/semaphore": "To bound how many tasks of one subject run at once, quota.concurrency"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\AiBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\AiBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
