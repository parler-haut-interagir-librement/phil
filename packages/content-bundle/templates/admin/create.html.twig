{% extends layout %}

{% block title %}{{ 'admin.create'|trans({}, 'phil_content') }}{% endblock %}

{% block content %}
    <h1>{{ 'admin.create'|trans({}, 'phil_content') }} — {{ ('kind.' ~ resource_key)|trans({}, 'phil_content') }}</h1>

    {% if error %}<p role="alert">{{ error }}</p>{% endif %}

    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <p>
            <label for="phil-content-locale">{{ 'admin.locale'|trans({}, 'phil_content') }}</label>
            <input id="phil-content-locale" name="locale" value="{{ locale }}" required>
        </p>
        <p>
            <label for="phil-content-slug">{{ 'admin.slug'|trans({}, 'phil_content') }}</label>
            <input id="phil-content-slug" name="slug" value="{{ slug }}">
        </p>
        <p><button type="submit">{{ 'admin.create'|trans({}, 'phil_content') }}</button></p>
    </form>
{% endblock %}
