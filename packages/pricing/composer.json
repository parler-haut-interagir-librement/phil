{
    "name": "phil/pricing",
    "description": "Price from cost without float errors: margin and markup, prices from a target margin, cascading discounts, blended margin and .99 price endings.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "pricing",
        "margin",
        "markup",
        "discount",
        "money"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/money": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Pricing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Pricing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
