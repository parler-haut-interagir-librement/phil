{
    "name": "phil/css-sanitizer",
    "description": "Let people style their pages without letting their CSS run code, load what it should not, or escape its frame: CSS parsed, filtered by allow lists, rewritten.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "css",
        "sanitizer",
        "css-syntax",
        "parser",
        "tokenizer",
        "security",
        "paged-media",
        "validator"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "ext-intl": "*",
        "phpunit/phpunit": "^13.4",
        "symfony/translation": "^8.2",
        "symfony/validator": "^8.2"
    },
    "suggest": {
        "ext-intl": "For the ICU catalogues of the constraint messages",
        "symfony/validator": "For the SafeCss constraint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\CssSanitizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\CssSanitizer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
