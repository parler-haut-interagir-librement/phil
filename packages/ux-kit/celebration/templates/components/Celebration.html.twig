{#-
 # A celebration: its message, said in a polite live region when it plays, and an effect that the `celebration`
 # controller draws over the page on a canvas, where motion is not reduced and the person has not chosen
 # `data-celebrations="none"`. It plays as soon as the page shows it with `autoplay`, on the DOM event `celebrate`, on a
 # `<turbo-stream action="celebrate">`, or by the action `celebration#play`. No style is written here: the canvas waits
 # in a template, and the controller sets it over the page through the CSSOM.
 #}
{%- props
    ## string The words of the victory, said when it plays, and shown where motion is reduced.
    message = '',
    ## list<string> Words said in turn when no message is given, one at random each time, another than the last.
    messages = [],
    ## 'confetti'|'fireworks'|'lasers'|'balloons'|'shooting-stars'|'streamers'|'coins'|'bubbles'|'aurora'|'spotlight'|'trophy' What is drawn; `confetti` for any other name.
    effect = 'confetti',
    ## bool Whether it plays as soon as the page shows it, for a page that arrives on a victory.
    autoplay = false,
    ## int How long the animation runs, in milliseconds, kept by the controller between 600 and 4000.
    duration = 2500,
    ## string The selector of what the spotlight lights and where the trophy lands; the middle of the screen without one.
    focus = ''
-%}
{%- set effects = ['confetti', 'fireworks', 'lasers', 'balloons', 'shooting-stars', 'streamers', 'coins', 'bubbles', 'aurora', 'spotlight', 'trophy'] -%}
<div data-celebration-message-value="{{ message }}" data-celebration-messages-value="{{ []|merge(messages|filter(text => text is not empty))|json_encode }}" data-celebration-effect-value="{{ effect in effects ? effect : 'confetti' }}" data-celebration-autoplay-value="{{ autoplay ? 'true' : 'false' }}" data-celebration-duration-value="{{ duration }}" data-celebration-focus-value="{{ focus }}" data-celebration-colors-value="--phil-color-brand-fill-loud --phil-color-success-fill-loud --phil-color-warning-fill-loud --phil-color-danger-fill-loud --phil-color-info-fill-loud"{{ attributes.defaults({class: 'isCelebration', 'data-controller': 'celebration'}) }}>
{##- What plays it, a button with `data-action="celebration#play"`, or anything else shown with the message. -#}
{%- block content %}{% endblock -%}
<p class="isCelebrationMessage" role="status" aria-live="polite" data-celebration-target="message">{{ autoplay ? (message is not empty ? message : messages|first|default('')) }}</p><template data-celebration-target="stage"><canvas class="isCelebrationCanvas" aria-hidden="true"></canvas></template></div>
