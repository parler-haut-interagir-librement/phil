{#-
 # A podium: the first three of a ranking, each on a step, in their order for screen readers and the second, the first
 # and the third side by side on the screen. Where motion is not reduced, the `podium` controller makes them rise on
 # their steps, the third first, when the podium comes into view or by the action `podium#rise`; then it says its
 # message and may play the `Celebration` of the page. Without the controller, or where motion is reduced, they stand
 # on their steps from the start.
 #}
{%- props
    ## list<array{name:string,score?:string|int|float}> The first three of the ranking, in their order; any more are left out.
    places = [],
    ## string The name of the podium, for screen readers.
    label = 'Podium',
    ## string What is said once they stand on their steps: the winner, as a rule.
    message = '',
    ## ''|'confetti'|'fireworks'|'lasers'|'balloons'|'shooting-stars'|'streamers'|'coins'|'bubbles'|'aurora'|'spotlight'|'trophy' The effect the `Celebration` of the page plays once they stand on their steps; none when empty.
    effect = '',
    ## bool Whether they rise as soon as the podium comes into view; otherwise by the action `podium#rise`.
    autoplay = true
-%}
<div data-podium-message-value="{{ message }}" data-podium-effect-value="{{ effect }}" data-podium-autoplay-value="{{ autoplay ? 'true' : 'false' }}"{{ attributes.defaults({class: 'isPodium', 'data-controller': 'podium'}) }}>
<ol class="isPodiumPlaces" aria-label="{{ label }}">
{%- for place in places|slice(0, 3) -%}
<li class="isPodiumPlace" data-place="{{ loop.index }}"><span class="isPodiumName">{{ place.name }}</span>{% if (place.score ?? null) is not null %}<span class="isPodiumScore">{{ place.score }}</span>{% endif %}<span class="isPodiumStep" aria-hidden="true">{{ loop.index }}</span></li>
{%- endfor -%}
</ol>
{##- What follows the podium: a button with `data-action="podium#rise"`, or the rest of the ranking. -#}
{%- block content %}{% endblock -%}
<p class="isPodiumMessage" role="status" aria-live="polite" data-podium-target="message"></p></div>
