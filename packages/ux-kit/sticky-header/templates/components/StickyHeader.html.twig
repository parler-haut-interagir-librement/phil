{#-
 # The header of the page, kept at the top of the screen while the page scrolls; anchors and the focus stop below it.
 # With `hideOnScroll`, it slides away while the reader scrolls down and comes back when they scroll up, never where
 # motion is reduced; hidden, it is inert, so that its links cannot be reached.
 #}
{%- props
    ## bool Whether it slides away while the reader scrolls down.
    hideOnScroll = false,
    ## int How far the page scrolls, in CSS pixels, before the header slides away or back.
    threshold = 8
-%}
<header data-sticky-header-hide-on-scroll-value="{{ hideOnScroll ? 'true' : 'false' }}" data-sticky-header-threshold-value="{{ threshold }}"{{ attributes.defaults({class: 'isStickyHeader' ~ (hideOnScroll ? ' hasHideOnScroll' : ''), 'data-controller': 'sticky-header'}) }}>
    {##- The brand, the navigation and the actions of the site. -#}
    {%- block content %}{% endblock -%}
</header>
