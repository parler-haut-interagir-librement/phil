{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% if collector.headers is not empty %}
        {% set icon %}
            <span class="sf-toolbar-value">CSP</span>
            <span class="sf-toolbar-label">{{ collector.policy ?? 'none' }}</span>
        {% endset %}
        {% set text %}
            {% for name, value in collector.headers %}
                <div class="sf-toolbar-info-piece">
                    <b>{{ name }}</b>
                    <span>{{ value|length }} bytes</span>
                </div>
            {% endfor %}
        {% endset %}
        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: true}) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label{{ collector.headers is empty ? ' disabled' }}">
        <strong>Content Security Policy</strong>
    </span>
{% endblock %}

{% block panel %}
    <h2>Content Security Policy</h2>
    {% if collector.headers is empty %}
        <div class="empty"><p>No policy was written on this response.</p></div>
    {% else %}
        <div class="metrics">
            <div class="metric"><span class="value">{{ collector.policy ?? '—' }}</span><span class="label">Policy</span></div>
            <div class="metric"><span class="value">{{ collector.overrides }}</span><span class="label">Overrides</span></div>
            <div class="metric"><span class="value">{{ collector.nonces is empty ? '—' : collector.nonces|join(', ') }}</span><span class="label">Nonces</span></div>
        </div>
        <table>
            <thead><tr><th>Header</th><th>Value</th></tr></thead>
            <tbody>
            {% for name, value in collector.headers %}
                <tr>
                    <td>{{ name }}</td>
                    <td><code>{% for part in value|split('; ') %}{{ part }}{{ loop.last ? '' : ';' }}<br>{% endfor %}</code></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
