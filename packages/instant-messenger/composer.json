{
    "name": "phil/instant-messenger",
    "description": "Instant messaging handles for PHP: messaging services as enums whose cases read, display and link their handles, the international services included, and the service of a handle detected among enum sets",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "instant-messaging",
        "whatsapp",
        "telegram",
        "phone",
        "signal",
        "enum",
        "value-object"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/enums": "^0.3@dev",
        "phil/phone": "^0.1@dev",
        "phil/url": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\InstantMessenger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\InstantMessenger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
