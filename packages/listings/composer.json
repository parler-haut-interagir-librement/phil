{
    "name": "phil/listings",
    "description": "The core of listings — classified ads, job offers, searches for partners: kinds with bounded policies, titles, typed criteria that meet a search, an area shown to all and an exact place shown to accepted respondents, expiry with reminders and extensions, moderation before or after publication with reports, and responses that put two members in touch with the consent of each",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "listings",
        "classifieds",
        "job-board",
        "matchmaking",
        "moderation"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Listings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Listings\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
