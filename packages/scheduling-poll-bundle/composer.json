{
    "name": "phil/scheduling-poll-bundle",
    "description": "Find a date that suits everyone: proposed dates answered yes, if need be or no by personal link without an account, best date chosen, iCalendar mailed to all.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "scheduling-poll",
        "availability",
        "date-poll",
        "icalendar",
        "personal-link",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/orm": "^3.7",
        "phil/access-links": "^0.2@dev",
        "phil/calendar-sync": "^0.1@dev",
        "phil/email-address": "^0.1@dev",
        "phil/poll": "^0.1.1@dev",
        "phil/poll-bundle": "^0.4@dev",
        "phil/resource": "^0.1@dev",
        "phil/url": "^0.1@dev",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/cache-contracts": "^3.6",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/lock": "^8.2",
        "symfony/mailer": "^8.2",
        "symfony/messenger": "^8.2",
        "symfony/mime": "^8.2",
        "symfony/scheduler": "^8.2",
        "symfony/translation-contracts": "^3.6",
        "symfony/uid": "^8.2"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.3",
        "phil/privacy-bundle": "^0.3@dev",
        "phil/ux-kit": "^0.5@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/cache": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/dom-crawler": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/security-csrf": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/ux-twig-component": "^3.7",
        "twig/intl-extra": "^3.30",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "To keep the polls, their respondents and their links in the application's database",
        "phil/privacy-bundle": "For the answers of a person in the export and the erasure of their data",
        "phil/ux-kit": "For the recipes the templates draw — Table, Field, Input, NativeSelect, Button —, through the Symfony UX Toolkit",
        "symfony/routing": "For the pages of a respondent, from config/routes.php",
        "symfony/security-csrf": "For a CSRF token in the forms of the pages",
        "symfony/twig-bundle": "For the templates of the pages and their functions",
        "twig/intl-extra": "For the dates written in the language of the page"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\SchedulingPollBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\SchedulingPollBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
