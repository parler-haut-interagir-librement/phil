{
    "name": "phil/checkin",
    "description": "Check people in at an event or a venue: a code read at the door, accepted or refused at once, recorded once, online or offline.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "check-in",
        "attendance",
        "admission",
        "ticketing",
        "offline",
        "events"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Checkin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Checkin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
