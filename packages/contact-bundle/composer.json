{
    "name": "phil/contact-bundle",
    "description": "phil/contact in Symfony: a contact card form with its emails, phone lines, web addresses, handles and structured person name, the JSON column type phil_contact, vCard and JSContact downloads, the JSContact reader as a service, and person names and schema.org JSON-LD in Twig",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "contact",
        "jscontact",
        "person-name",
        "vcard",
        "schema.org",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/contact": "^0.1@dev",
        "phil/instant-messenger-bundle": "^0.1@dev",
        "phil/phone": "^0.1@dev",
        "phil/phone-bundle": "^0.1@dev",
        "phil/url-bundle": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/form": "^8.2",
        "symfony/options-resolver": "^8.2"
    },
    "require-dev": {
        "ext-intl": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "phil/instant-messenger": "^0.1@dev",
        "phil/structured-data": "^0.1@dev",
        "phil/url": "^0.1@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/validator": "^8.2",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "doctrine/dbal": "For the phil_contact column type",
        "phil/structured-data-bundle": "For contact_json_ld adding the card to the one graph of the page",
        "symfony/http-foundation": "For VCardResponse and JSContactResponse",
        "twig/twig": "For contact_vcard, contact_json_ld, person_name and the form theme"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\ContactBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\ContactBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
