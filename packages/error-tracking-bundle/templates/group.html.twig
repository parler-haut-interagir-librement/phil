{#
    One group of errors: its status and the forms that change it, then its latest events, each with its chain of
    exceptions and their frames, its request and its tags. Every value has gone through the scrubber.
#}
{% extends layout %}

{% block title %}{{ group.title|slice(0, 80) }}{% endblock %}

{% block main %}
    <p><a href="{{ path(routes.groups) }}">All errors</a></p>

    <h1>{{ group.title }}</h1>

    {{ include('@PhilErrorTracking/_alerts.html.twig') }}

    <dl>
        <dt>Status</dt><dd>{{ group.status.value }}{% if group.resolvedRelease %} (on {{ group.resolvedRelease }}){% endif %}</dd>
        <dt>Culprit</dt><dd>{{ group.culprit ?? 'unknown' }}</dd>
        <dt>Events</dt><dd>{{ group.timesSeen }}</dd>
        <dt>First seen</dt><dd><time datetime="{{ group.firstSeen|date('c') }}">{{ group.firstSeen|date('Y-m-d H:i') }}</time></dd>
        <dt>Last seen</dt><dd><time datetime="{{ group.lastSeen|date('c') }}">{{ group.lastSeen|date('Y-m-d H:i') }}</time>{% if group.lastRelease %} on {{ group.lastRelease }}{% endif %}</dd>
        <dt>Fingerprint</dt><dd><code>{{ group.fingerprint }}</code></dd>
    </dl>

    {% for action in ['resolve', 'ignore', 'reopen'] %}
        <form method="post" action="{{ path(routes.status, {fingerprint: group.fingerprint, action: action}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <button type="submit">{{ action|capitalize }}</button>
        </form>
    {% endfor %}

    {% for event in events %}
        <section>
            <h2><time datetime="{{ event.occurredAt|date('c') }}">{{ event.occurredAt|date('Y-m-d H:i:s') }}</time> · {{ event.source.value }} · {{ event.severity.value }}</h2>
            <p>Release {{ event.release ?? 'unknown' }}, environment {{ event.environment ?? 'unknown' }}.</p>

            {% for exception in event.exceptions %}
                <h3>{% if not loop.first %}Caused by {% endif %}{{ exception.type }}</h3>
                <pre>{{ exception.message }}</pre>
                <ol>
                    {% for frame in exception.frames %}
                        <li{% if not frame.inApp %} class="is-vendor"{% endif %}><code>{{ frame.label }}</code></li>
                    {% endfor %}
                </ol>
            {% endfor %}

            {% if event.request %}
                <h3>Request</h3>
                <p><code>{{ event.request.method }} {{ event.request.url }}</code>{% if event.request.route %} ({{ event.request.route }}){% endif %}{% if event.request.clientAddress %} from {{ event.request.clientAddress }}{% endif %}</p>
                <table>
                    {% for name, value in event.request.headers %}
                        <tr><th scope="row">{{ name }}</th><td>{{ value }}</td></tr>
                    {% endfor %}
                </table>
            {% endif %}

            {% if event.context is not empty %}
                <h3>Tags</h3>
                <table>
                    {% for name, value in event.context %}
                        <tr><th scope="row">{{ name }}</th><td>{{ value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value) }}</td></tr>
                    {% endfor %}
                </table>
            {% endif %}
        </section>
    {% else %}
        <p>No event kept.</p>
    {% endfor %}
{% endblock %}
