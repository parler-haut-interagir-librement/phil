{
    "name": "phil/usage-meter-bundle",
    "description": "Quotas in Symfony: meters declared in configuration, counters in the database, limits from providers or subscriptions, rate limiters that count on a meter.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "quota",
        "metering",
        "usage",
        "rate-limit",
        "subscription",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/rate-limit-bundle": "^0.1@dev",
        "phil/usage-meter": "^0.1@dev",
        "psr/clock": "^1.0",
        "symfony/config": "^8.2",
        "symfony/console": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "phil/commerce-subscription-bundle": "^0.1@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/browser-kit": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/yaml": "^8.2"
    },
    "suggest": {
        "doctrine/dbal": "For the store \"dbal\", the counters in a database",
        "doctrine/orm": "To add the counter tables to the schema the ORM generates",
        "phil/commerce-subscription-bundle": "For the limits read from the features of a subscriber's offers"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\UsageMeterBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\UsageMeterBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
