{
    "name": "phil/bot-detection-bundle",
    "description": "Bot detection for Symfony whose only output is a robot or human verdict: in-browser automation detectors in a Stimulus controller, a strict verdict, a verdict-to-friction policy and an aggregate robot verdict counter",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\BotDetectionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\BotDetectionBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
