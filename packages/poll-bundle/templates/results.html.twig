{#-
 # The results of a poll, in the markup of the kit's recipe Progress, or a sentence while they are not the viewer's to
 # see. Once the poll is closed, its results are revealed: the controller `phil--poll-bundle--results` dispatches the
 # DOM event `poll:revealed` on the window, once per page and poll, and the block `revealed` is drawn — empty, for an
 # embedding page to fill, with the kit's Celebration for one.
 #
 #   results   the ResultsView of `phil_poll_results()`, or null
 #}
{%- set domain = 'phil_poll' -%}
{%- if results is not null %}
{%- set id = 'phil-poll-results-' ~ results.poll -%}
{%- set c = 'phil--poll-bundle--results' -%}
<section class="phil-poll-results" aria-labelledby="{{ id }}-title" data-controller="{{ c }}" data-{{ c }}-poll-value="{{ results.poll }}" data-{{ c }}-revealed-value="{{ results.revealed ? 'true' : 'false' }}" data-{{ c }}-winners-value="{{ results.winners|json_encode }}">
    <h2 id="{{ id }}-title">{{ results.question }}</h2>
    <p class="phil-poll-results__ballots">{{ 'results.ballots'|trans({'%count%': results.ballots}, domain) }}{% if results.abstentions > 0 %} {{ 'results.abstentions'|trans({'%count%': results.abstentions}, domain) }}{% endif %}</p>
    {%- block lines %}
    <ol class="phil-poll-results__lines">
        {%- for line in results.lines %}
        <li class="phil-poll-results__line"{% if line.winner %} data-winner="true"{% endif %}>
            <span id="{{ id }}-{{ line.option }}">{{ line.label }}</span>
            {%- if line.winner %} <strong>{{ (results.seats > 1 ? 'results.elected' : 'results.winner')|trans({}, domain) }}</strong>{% endif %}
            <progress data-slot="progress" max="{{ line.max }}" value="{{ max(0, min(line.max, line.score)) }}" aria-labelledby="{{ id }}-{{ line.option }}"></progress>
            <span class="phil-poll-results__score">{{ line.display }}</span>
        </li>
        {%- endfor %}
    </ol>
    {%- endblock %}
    {%- if results.revealed %}
    {%- block revealed %}{% endblock %}
    {%- endif %}
</section>
{%- else %}
<p class="phil-poll-results phil-poll-results--hidden" role="status">{{ 'results.hidden'|trans({}, domain) }}</p>
{%- endif %}
