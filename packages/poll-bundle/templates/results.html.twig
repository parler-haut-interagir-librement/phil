{#-
 # The results of a poll, each bar the kit's recipe Progress — installed from the PHIL UX kit or from the Shadcn kit,
 # named by `phil_poll_kit()` —, or a sentence while they are not the viewer's to see. Once the poll is closed, its
 # results are revealed: the controller `phil--poll-bundle--results` dispatches the DOM event `poll:revealed` on the
 # window, once per page and poll, and the block `revealed` is drawn — empty, for an embedding page to fill, with the
 # kit's Celebration for one.
 #
 #   results   the ResultsView of `phil_poll_results()`, or null
 #
 # Each bar is given its share of the highest score, from 0 to 100, as both kits' Progress take it, and the score as
 # written for its text. A scale lists its marks from the lowest, and adds its mean mark; a Net Promoter Score adds its
 # three groups and its score. The numbers are written with the separators of the domain's `number.decimal` and
 # `number.thousands`.
 #}
{%- set domain = 'phil_poll' -%}
{%- if results is not null %}
{%- set id = 'phil-poll-results-' ~ results.poll -%}
{%- set c = 'phil--poll-bundle--results' -%}
{%- set kit = {Progress: phil_poll_kit('Progress')} -%}
<section class="phil-poll-results" aria-labelledby="{{ id }}-title" data-controller="{{ c }}" data-{{ c }}-poll-value="{{ results.poll }}" data-{{ c }}-revealed-value="{{ results.revealed ? 'true' : 'false' }}" data-{{ c }}-winners-value="{{ results.winners|json_encode }}">
    <h2 id="{{ id }}-title">{{ results.question }}</h2>
    <p class="phil-poll-results__ballots">{{ 'results.ballots'|trans({'%count%': results.ballots}, domain) }}{% if results.abstentions > 0 %} {{ 'results.abstentions'|trans({'%count%': results.abstentions}, domain) }}{% endif %}</p>
    {%- block lines %}
    <ol class="phil-poll-results__lines">
        {%- for line in results.lines %}
        <li class="phil-poll-results__line"{% if line.winner %} data-winner="true"{% endif %}>
            <span id="{{ id }}-{{ line.option }}">{{ line.label }}</span>
            {%- if line.winner %} <strong>{{ (results.seats > 1 ? 'results.elected' : 'results.winner')|trans({}, domain) }}</strong>{% endif %}
            {{ component(kit.Progress, {value: (line.score * 100 / line.max)|round, 'aria-labelledby': id ~ '-' ~ line.option, 'aria-valuetext': line.display}) }}
            <span class="phil-poll-results__score">{{ line.display }}</span>
        </li>
        {%- endfor %}
    </ol>
    {%- endblock %}
    {%- block rating %}
    {%- set decimal = 'number.decimal'|trans({}, domain) -%}
    {%- set thousands = 'number.thousands'|trans({}, domain) -%}
    {%- if results.rating is not null and results.rating.mean is not null %}
    <p class="phil-poll-results__mean">{{ 'results.mean'|trans({'%mean%': results.rating.mean|number_format(2, decimal, thousands), '%count%': results.rating.marked}, domain) }}</p>
    {%- endif %}
    {%- if results.netPromoter is not null and results.netPromoter.score is not null %}
    <dl class="phil-poll-results__nps">
        <dt>{{ 'results.nps.score'|trans({}, domain) }}</dt>
        <dd>{{ results.netPromoter.score|round|number_format(0, decimal, thousands) }}</dd>
        <dt>{{ 'results.nps.promoters'|trans({}, domain) }}</dt>
        <dd>{{ results.netPromoter.promoters|number_format(0, decimal, thousands) }}</dd>
        <dt>{{ 'results.nps.passives'|trans({}, domain) }}</dt>
        <dd>{{ results.netPromoter.passives|number_format(0, decimal, thousands) }}</dd>
        <dt>{{ 'results.nps.detractors'|trans({}, domain) }}</dt>
        <dd>{{ results.netPromoter.detractors|number_format(0, decimal, thousands) }}</dd>
    </dl>
    {%- endif %}
    {%- endblock %}
    {%- if results.revealed %}
    {%- block revealed %}{% endblock %}
    {%- endif %}
</section>
{%- else %}
<p class="phil-poll-results phil-poll-results--hidden" role="status">{{ 'results.hidden'|trans({}, domain) }}</p>
{%- endif %}
