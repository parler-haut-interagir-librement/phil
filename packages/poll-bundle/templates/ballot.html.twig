{#-
 # The form of a poll's ballot, drawn with the kit's recipes — Field, RadioGroup, Checkbox, NativeSelect and Button —,
 # installed from the PHIL UX kit or from the Shadcn kit. It posts the fields `BallotForm` reads, and works without
 # JavaScript. Embed it to replace a block: `choices`, `status` or `actions`. The recipes are named once, at the top,
 # by `phil_poll_kit()`, in the map `kit` the blocks may use.
 #
 #   ballot       the BallotView of `phil_poll_ballot()`
 #   action       the address the form posts to
 #   csrf_token   the CSRF token of the form, posted as `_token`; none when null
 #}
{%- set domain = 'phil_poll' -%}
{%- set id = 'phil-poll-' ~ ballot.poll -%}
{%- set kit = {
    Field: phil_poll_kit('Field'),
    FieldSet: phil_poll_kit('Field:Set'),
    FieldLegend: phil_poll_kit('Field:Legend'),
    FieldDescription: phil_poll_kit('Field:Description'),
    FieldLabel: phil_poll_kit('Field:Label'),
    RadioGroup: phil_poll_kit('RadioGroup'),
    RadioGroupItem: phil_poll_kit('RadioGroup:Item'),
    Checkbox: phil_poll_kit('Checkbox'),
    NativeSelect: phil_poll_kit('NativeSelect'),
    NativeSelectOption: phil_poll_kit('NativeSelect:Option'),
    Button: phil_poll_kit('Button'),
} -%}
<form method="post" action="{{ action }}" class="phil-poll-ballot" data-phil-poll="{{ ballot.poll }}">
    {%- if csrf_token ?? null %}
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    {%- endif %}
    {%- set help -%}
        {%- if ballot.kind is same as('single') -%}
            {{ 'ballot.help.single'|trans({}, domain) }}
        {%- elseif ballot.kind is same as('multiple') -%}
            {{ 'ballot.help.multiple'|trans({'%min%': ballot.minChoices, '%max%': ballot.maxChoices}, domain) }}
        {%- else -%}
            {{ 'ballot.help.ranked'|trans({'%min%': ballot.minChoices, '%max%': ballot.maxChoices}, domain) }}
        {%- endif -%}
        {%- if ballot.seats > 1 %} {{ 'ballot.help.seats'|trans({'%count%': ballot.seats}, domain) }}{% endif -%}
    {%- endset -%}
    {#- The choices are drawn here, where an embedding template replaces them, then placed in the fieldset. -#}
    {%- set fields -%}
        {%- block choices %}
        {%- if ballot.kind is same as('single') %}
        {% component (kit.RadioGroup) with {name: 'choice', value: ballot.choices|filter(choice => choice.chosen)|map(choice => choice.id)|first|default(null), required: not ballot.abstention, 'aria-labelledby': id ~ '-question'} %}
            {% block content %}
            <span id="{{ id }}-question" hidden>{{ ballot.question }}</span>
            {%- for choice in ballot.choices %}
            {% component (kit.Field) with {orientation: 'horizontal'} %}
                {% block content %}
                {{ component(kit.RadioGroupItem, {value: choice.id, id: id ~ '-' ~ choice.id}) }}
                {% component (kit.FieldLabel) with {for: id ~ '-' ~ choice.id} %}{% block content %}{{ choice.label }}{% endblock %}{% endcomponent %}
                {% endblock %}
            {% endcomponent %}
            {%- endfor %}
            {%- if ballot.abstention %}
            {% component (kit.Field) with {orientation: 'horizontal'} %}
                {% block content %}
                {{ component(kit.RadioGroupItem, {value: '', id: id ~ '--blank'}) }}
                {% component (kit.FieldLabel) with {for: id ~ '--blank'} %}{% block content %}{{ 'ballot.blank'|trans({}, domain) }}{% endblock %}{% endcomponent %}
                {% endblock %}
            {% endcomponent %}
            {%- endif %}
            {% endblock %}
        {% endcomponent %}
        {%- elseif ballot.kind is same as('multiple') %}
        {%- for choice in ballot.choices %}
        {% component (kit.Field) with {orientation: 'horizontal'} %}
            {% block content %}
            {{ component(kit.Checkbox, {name: 'choices[]', value: choice.id, id: id ~ '-' ~ choice.id, checked: choice.chosen}) }}
            {% component (kit.FieldLabel) with {for: id ~ '-' ~ choice.id} %}{% block content %}{{ choice.label }}{% endblock %}{% endcomponent %}
            {% endblock %}
        {% endcomponent %}
        {%- endfor %}
        {%- else %}
        {%- for choice in ballot.choices %}
        {% component (kit.Field) with {orientation: 'horizontal'} %}
            {% block content %}
            {% component (kit.FieldLabel) with {for: id ~ '-' ~ choice.id} %}{% block content %}{{ choice.label }}{% endblock %}{% endcomponent %}
            {% component (kit.NativeSelect) with {size: 'sm', name: 'ranks[' ~ choice.id ~ ']', id: id ~ '-' ~ choice.id} %}
                {% block content %}
                {% component (kit.NativeSelectOption) with {value: ''} %}{% block content %}{{ 'ballot.unranked'|trans({}, domain) }}{% endblock %}{% endcomponent %}
                {%- for rank in 1..ballot.maxChoices %}
                {% component (kit.NativeSelectOption) with {value: rank, selected: choice.rank is same as(rank)} %}{% block content %}{{ 'ballot.rank'|trans({'%rank%': rank}, domain) }}{% endblock %}{% endcomponent %}
                {%- endfor %}
                {% endblock %}
            {% endcomponent %}
            {% endblock %}
        {% endcomponent %}
        {%- endfor %}
        {%- endif %}
        {%- endblock %}
    {%- endset %}
    {% component (kit.FieldSet) with {'aria-describedby': id ~ '-help', disabled: not ballot.editable} %}
        {% block content %}
        {% component (kit.FieldLegend) %}{% block content %}{{ ballot.question }}{% endblock %}{% endcomponent %}
        {% component (kit.FieldDescription) with {id: id ~ '-help'} %}{% block content %}{{ help }}{% endblock %}{% endcomponent %}
        {{ fields }}
        {% endblock %}
    {% endcomponent %}
    {%- block status %}
    <p class="phil-poll-ballot__status" role="status">
        {%- if not ballot.open -%}
            {{ 'ballot.closed'|trans({}, domain) }}
        {%- elseif ballot.voted -%}
            {{ (ballot.anonymous ? 'ballot.voted_anonymous' : 'ballot.voted')|trans({}, domain) }}
        {%- elseif ballot.anonymous -%}
            {{ 'ballot.anonymous'|trans({}, domain) }}
        {%- endif -%}
    </p>
    {%- endblock %}
    {%- block actions %}
    {%- if ballot.editable %}
    {% component (kit.Button) with {type: 'submit'} %}{% block content %}{{ (ballot.mayChange ? 'ballot.change' : 'ballot.cast')|trans({}, domain) }}{% endblock %}{% endcomponent %}
    {%- endif %}
    {%- endblock %}
</form>
