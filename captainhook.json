{
    "config": {
        "ansi-colors": true,
        "fail-on-first-error": false,
        "run": {
            "mode": "shell",
            "path": "vendor-bin/captainhook/vendor/bin/captainhook"
        }
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "bin/staged php-cs-fixer",
                "conditions": [
                    {
                        "exec": "\\CaptainHook\\App\\Hook\\Condition\\FileStaged\\OfType",
                        "args": [
                            "php"
                        ]
                    }
                ]
            },
            {
                "action": "bin/staged phpstan --in-dir=packages/",
                "conditions": [
                    {
                        "exec": "\\CaptainHook\\App\\Hook\\Condition\\FileStaged\\OfType",
                        "args": [
                            "php"
                        ]
                    }
                ]
            },
            {
                "action": "php vendor/bin/phil-dev twig",
                "conditions": [
                    {
                        "exec": "\\CaptainHook\\App\\Hook\\Condition\\FileStaged\\OfType",
                        "args": [
                            "twig"
                        ]
                    }
                ]
            },
            {
                "action": "php vendor/bin/phil-dev normalize",
                "conditions": [
                    {
                        "exec": "\\CaptainHook\\App\\Hook\\Condition\\FileStaged\\OfType",
                        "args": [
                            "json"
                        ]
                    }
                ]
            },
            {
                "action": "php vendor/bin/phil-dev check-docs",
                "conditions": [
                    {
                        "exec": "\\CaptainHook\\App\\Hook\\Condition\\FileStaged\\OfType",
                        "args": [
                            "md"
                        ]
                    }
                ]
            }
        ]
    }
}
