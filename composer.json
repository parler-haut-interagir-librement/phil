{
    "name": "phil/phil",
    "description": "PHIL (Proclaim Honestly, Interact Liberally): the libraries and Symfony bundles of the phil-ip platform, developed together and split into read-only repositories.",
    "license": "MIT",
    "type": "project",
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-tokenizer": "*",
        "ext-uri": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "api-platform/json-schema": "^5.0",
        "api-platform/metadata": "^5.0",
        "api-platform/symfony": "^5.0",
        "bamarni/composer-bin-plugin": "^1.9",
        "brianium/paratest": "^7.27",
        "doctrine/collections": "^3.0",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "doctrine/persistence": "^4.1",
        "easycorp/easyadmin-bundle": "^5.8",
        "ergebnis/phpunit-slow-test-detector": "^2.27",
        "league/flysystem": "^3.30",
        "league/flysystem-local": "^3.30",
        "league/flysystem-memory": "^3.29",
        "liip/imagine-bundle": "^2.18",
        "loupe/loupe": "^1.1",
        "monolog/monolog": "^3.0",
        "nelmio/api-doc-bundle": "^5.13",
        "phil/dev-tools": "^0.1@dev",
        "phil/ux-css": "^0.5@dev",
        "phil/ux-kit": "^0.5@dev",
        "php-webdriver/webdriver": "^1.16",
        "phpunit/phpunit": "^13.4",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/link": "^2.0",
        "psr/log": "^3.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/asset-mapper": "^8.2",
        "symfony/browser-kit": "^8.2",
        "symfony/cache": "^8.2",
        "symfony/cache-contracts": "^3.6",
        "symfony/clock": "^8.2",
        "symfony/config": "^8.2",
        "symfony/console": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/dom-crawler": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/event-dispatcher-contracts": "^3.6",
        "symfony/expression-language": "^8.2",
        "symfony/filesystem": "^8.2",
        "symfony/form": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/html-sanitizer": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/http-client-contracts": "^3.6",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/intl": "^8.2",
        "symfony/key-management": "^8.2",
        "symfony/lock": "^8.2",
        "symfony/mailer": "^8.2",
        "symfony/maker-bundle": "^1.68",
        "symfony/mercure": "^0.10",
        "symfony/mercure-bundle": "^0.7",
        "symfony/messenger": "^8.2",
        "symfony/mime": "^8.2",
        "symfony/monolog-bundle": "^4.1",
        "symfony/notifier": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/panther": "^2.4",
        "symfony/process": "^8.2",
        "symfony/property-access": "^8.2",
        "symfony/property-info": "^8.2",
        "symfony/rate-limiter": "^8.2",
        "symfony/routing": "^8.2",
        "symfony/scheduler": "^8.2",
        "symfony/security-bundle": "^8.2",
        "symfony/security-core": "^8.2",
        "symfony/security-csrf": "^8.2",
        "symfony/security-http": "^8.2",
        "symfony/serializer": "^8.2",
        "symfony/service-contracts": "^3.6",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/string": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/translation-contracts": "^3.6",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/type-info": "^8.2",
        "symfony/uid": "^8.2",
        "symfony/ux-live-component": "^3.7",
        "symfony/ux-twig-component": "^3.7",
        "symfony/validator": "^8.2",
        "symfony/web-link": "^8.2",
        "symfony/workflow": "^8.2",
        "symfony/yaml": "^8.2",
        "twig/extra-bundle": "^3.24",
        "twig/html-extra": "^3.24",
        "twig/twig": "^3.21",
        "web-token/jwt-library": "^4.2",
        "zircote/swagger-php": "^7.1"
    },
    "replace": {
        "symfony/polyfill-ctype": "1.99",
        "symfony/polyfill-iconv": "1.99",
        "symfony/polyfill-intl-grapheme": "1.99",
        "symfony/polyfill-intl-icu": "1.99",
        "symfony/polyfill-intl-idn": "1.99",
        "symfony/polyfill-intl-normalizer": "1.99",
        "symfony/polyfill-mbstring": "1.99",
        "symfony/polyfill-php83": "1.99",
        "symfony/polyfill-php84": "1.99",
        "symfony/polyfill-php85": "1.99"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Phil\\EnumsBundle\\Tests\\": "packages/enums-bundle/tests/"
        },
        "files": [
            "vendor/phil/dev-tools/resources/autoload-members.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true,
            "target-directory": "vendor-bin"
        }
    },
    "scripts": {
        "arkitect": "vendor-bin/arkitect/vendor/bin/phparkitect check --config=arkitect.php",
        "bc": "@php vendor/bin/phil-dev bc",
        "bench": "@php vendor/bin/phil-dev bench",
        "bench:baseline": "@php vendor/bin/phil-dev bench --baseline",
        "bench:compare": "@php vendor/bin/phil-dev bench --compare",
        "bench:worker": "@php vendor/bin/phil-dev bench:worker",
        "cs": "vendor-bin/php-cs-fixer/vendor/bin/php-cs-fixer check --diff",
        "cs:fix": "vendor-bin/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "deps": "vendor/bin/composer-dependency-analyser",
        "deps:audit": "@php vendor/bin/phil-dev audit",
        "deps:normalize": "@php vendor/bin/phil-dev normalize",
        "deps:normalize:fix": "@php vendor/bin/phil-dev normalize --fix",
        "deps:unused": "@php vendor/bin/phil-dev unused",
        "deptrac": "@php vendor/bin/phil-dev deptrac",
        "docs": "@php vendor/bin/phil-dev check-docs",
        "docs:lint": "@php vendor/bin/phil-dev lint-docs",
        "fuzz": "@php vendor/bin/phil-dev fuzz",
        "gates": [
            "@deps",
            "@deps:audit",
            "@deps:unused",
            "@deps:normalize",
            "@cs",
            "@twig",
            "@js",
            "@phpstan",
            "@rector",
            "@deptrac",
            "@arkitect",
            "@test",
            "@infection"
        ],
        "hooks": "vendor-bin/captainhook/vendor/bin/captainhook install --force --configuration=captainhook.json",
        "hotspots": "@php vendor/bin/phil-dev hotspots",
        "infection": "@php vendor/bin/phil-dev infection",
        "infection:changed": "@php vendor/bin/phil-dev infection --changed",
        "infection:next": "@php vendor/bin/phil-dev php next -- php vendor/bin/phil-dev infection",
        "js": "@php vendor/bin/phil-dev js",
        "js:fix": "@php vendor/bin/phil-dev js --fix",
        "packages": "@php vendor/bin/phil-dev check-packages",
        "packages:next": "@php vendor/bin/phil-dev php next -- php vendor/bin/phil-dev check-packages",
        "phpstan": [
            "vendor-bin/phpstan/vendor/bin/phpstan analyse --no-progress",
            "@php vendor/bin/phil-dev witnesses"
        ],
        "rector": "vendor-bin/rector/vendor/bin/rector process --dry-run",
        "rector:fix": "vendor-bin/rector/vendor/bin/rector process",
        "sbom": "@php vendor/bin/phil-dev sbom",
        "split": "@php vendor/bin/phil-dev split",
        "taint": "@php vendor/bin/phil-dev taint",
        "test": "@php vendor/bin/phil-dev test",
        "test:browser": [
            "npm ci --ignore-scripts --no-audit --no-fund --prefix packages/ux-kit/tests/Browser",
            "npm ci --ignore-scripts --no-audit --no-fund --prefix packages/search-bundle/tests/Browser",
            "vendor/bin/phpunit --configuration=phpunit.browser.dist.xml"
        ],
        "test:integration": "@php vendor/bin/phil-dev test --suite=Integration",
        "test:next": "@php vendor/bin/phil-dev php next",
        "test:services": "@php vendor/bin/phil-dev services test",
        "test:unit": "@php vendor/bin/phil-dev test --suite=Unit",
        "twig": "@php vendor/bin/phil-dev twig",
        "twig:fix": "@php vendor/bin/phil-dev twig --fix",
        "twigstan": "@php vendor/bin/phil-dev twigstan"
    },
    "scripts-descriptions": {
        "bc": "The public API against the latest tag, for backward-compatibility breaks.",
        "bench:baseline": "The benchmarks, stored as the baseline of this machine.",
        "bench:compare": "The benchmarks against the baseline, failing above the threshold of bench.threshold.",
        "bench:worker": "A page served by FrankenPHP in worker mode, measured.",
        "deps:audit": "The installed packages against the security advisories.",
        "deps:normalize": "Every composer.json checked against composer-normalize.",
        "deps:normalize:fix": "Every composer.json normalized.",
        "deps:unused": "The required packages the code never uses, with composer-unused.",
        "deptrac": "The layers, generated from the composer.json and phil-dev.php of each package.",
        "docs": "The documentation checks of each package.",
        "docs:lint": "The prose of the documentation, with cspell, markdownlint and Vale; a script of its own.",
        "fuzz": "The fuzz targets of the packages, each for its time budget; a script of its own.",
        "gates": "Every quality gate, in order: the slow checks are scripts of their own.",
        "hooks": "Installs the git hooks of captainhook.json: the fast gates on the staged files before each commit.",
        "hotspots": "The files that change most and are the most complex, with churn-php.",
        "infection": "Mutation testing of the whole code at 100 % of covered mutants.",
        "infection:changed": "Mutation testing of the files changed since the base ref (PHIL_DEV_BASE_REF, else origin/main), once per batch.",
        "infection:next": "Mutation testing of the whole code on the next PHP of the matrix, weekly and before a release.",
        "js": "The Stimulus controllers and other scripts, checked by Biome.",
        "packages": "Each package installed on its own, with its dependency analysis and its tests.",
        "packages:next": "The same, on the next PHP of the matrix.",
        "phpstan": "PHPStan at the maximum level, then the witnesses that prove each forbidden call is still reported.",
        "sbom": "The CycloneDX bill of materials of each package, under var/phil-dev/sbom/.",
        "split": "The finished packages split to their public repositories; dry run unless --push is given.",
        "taint": "The taint analysis of Psalm on the production code; a script of its own.",
        "test": "The tests with ParaTest, one process per core, or PHPUnit when ParaTest is missing.",
        "test:browser": "The browser suites of phpunit.browser.dist.xml, with Panther, the chromedriver of the system and the Stimulus of the npm lock files of the kit and of search-bundle; a script of its own, run before a release.",
        "test:next": "The tests on the next PHP of the matrix, in its Docker image.",
        "test:services": "The Integration suite against the MySQL, PostgreSQL and Gotenberg of phil-dev services.",
        "twig": "The code style of the Twig templates, with Twig-CS-Fixer.",
        "twigstan": "The Twig templates analysed by TwigStan; a script of its own."
    }
}
