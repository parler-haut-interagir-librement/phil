/vendor/
/vendor-bin/*/vendor/
/var/
/packages/*/tests/Browser/node_modules/
.phpunit.cache/
.php-cs-fixer.cache
/infection*.log
.claude/
.DS_Store

# Written at cache warm-up by the test kernel of each bundle.
/packages/*/tests/Functional/App/config/reference.php
/packages/*/tests/Functional/App/*/config/reference.php
/packages/*/tests/Functional/App/config/schema.json
/packages/*/tests/Functional/Plain/config/reference.php
/packages/*/tests/Functional/Plain/config/schema.json
/packages/*/tests/Functional/App/var/

# Fixtures ZIP des tests, que le .gitignore global de la machine (*.zip) ferait oublier
!packages/*/tests/**/*.zip

# Inputs the fuzzer adds to a corpus, named by their MD5: only named seeds are committed (CONTRIBUTING.md, Fuzzing).
/packages/*/tests/Fuzz/corpus/**/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].txt
