<?xml version="1.0" encoding="UTF-8"?>

<!--
    The suites that drive a real browser, with symfony/panther and the chromedriver of the system. Apart from
    phpunit.dist.xml, whose suites `composer test` runs: `composer test:browser` runs these, before a release.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         requireCoverageMetadata="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/phpunit-browser"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <!-- Panther reduces motion by default, which would still everything the suite means to watch moving. -->
        <server name="PANTHER_NO_REDUCED_MOTION" value="1" />
    </php>

    <testsuites>
        <testsuite name="Browser">
            <directory>packages/*/tests/Browser</directory>
        </testsuite>
    </testsuites>
</phpunit>
