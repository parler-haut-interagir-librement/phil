<?xml version="1.0" encoding="UTF-8"?>

<!--
    In a monorepo, the suites of every package are found by their glob: adding a package adds no line here.
    Unit runs without a kernel and touches nothing: it is the suite Infection replays once per mutant.
    Every test names what it covers, with #[CoversClass] or #[CoversNothing]: coverage counts only what a test
    sets out to test, and Infection replays only the tests that cover a mutant.
    Integration boots a kernel or talks to a real server; a test that needs a server reads its URL from the
    environment and is skipped without it (phil-dev services).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         requireCoverageMetadata="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/phpunit"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <!-- A console block wraps at the terminal's width: some tests look for a sentence next to a temporary path, whose
             length depends on the machine. A wide terminal keeps the sentence on one line wherever the tests run. -->
        <env name="COLUMNS" value="240" force="true" />
    </php>

    <testsuites>
        <testsuite name="Unit">
            <directory>tests</directory>
            <directory>packages/*/tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>packages/*/tests/Integration</directory>
            <directory>packages/*/tests/Functional</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>packages/*/src</directory>
        </include>
    </source>

    <extensions>
        <bootstrap class="Ergebnis\PHPUnit\SlowTestDetector\Extension" />
    </extensions>
</phpunit>
