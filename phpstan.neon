# The shared PHPStan configuration of phil/dev-tools. The paths and exceptions come from phil-dev.php; what only this
# project needs (a Symfony container, a Doctrine object manager) goes below.
includes:
    - vendor/phil/dev-tools/config/phpstan.neon

parameters:
    tmpDir: var/phpstan

    # The functions of the service configurators, `service()` among them, live in the file of ContainerConfigurator,
    # which no autoloader names: PHPStan finds them only in a worker that loaded the class first, so whether a file that
    # calls them passes depends on how the files are shared among the workers. Scanning the file settles it.
    scanFiles:
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php

    # The monorepo has no application, so no Symfony container for PHPStan to read. Each exception below names the lines
    # it covers; each one stays until the package line is written so that it holds either way.
    #
    # Without a container, the inline exception of this test for a service the container would not know matches nothing,
    # and an unmatched inline exception cannot be ignored: the file is left out here.
    excludePaths:
        analyse:
            - packages/enums-bundle/tests/Functional/OpenApiTest.php
            # Files the full run never analyses, which the pre-commit hook would when they are staged: the phil-dev.php of
            # each package, read by phil/dev-tools, names Rector rules that live in vendor-bin; the script that imports
            # the address data runs against commerceguys/addressing, installed only for that import.
            - packages/*/phil-dev.php
            - packages/address/bin/import-data.php

    ignoreErrors:
        # Without a container, a service read from a test kernel is an `object`.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method object::clear\(\)\.$#'
            path: packages/geo-bundle/tests/Functional/GeoBundleTest.php
            count: 1

        # Without an object manager, the Doctrine extension reads the mapping attributes alone: it does not see the field
        # a subclass maps, the type a custom DBAL type converts to, or the lifecycle callback that fills a column before
        # it is written.
        -
            identifier: doctrine.finalConstructor
            path: packages/content-bundle/src/Domain/Content/AbstractDimensionContent.php
            count: 1
        -
            identifier: doctrine.findOneByArgument
            path: packages/content-bundle/src/Infrastructure/Doctrine/DoctrineDimensionContentRepository.php
            count: 3
        -
            identifier: doctrine.findByArgument
            path: packages/content-bundle/src/Infrastructure/Doctrine/DoctrineDimensionContentRepository.php
            count: 2
        -
            identifier: doctrine.columnType
            path: packages/content-bundle/tests/Unit/Infrastructure/Doctrine/Fixture/Label.php
            count: 2
        -
            identifier: doctrine.columnType
            path: packages/doctrine-behaviours/src/TimestampableEntity.php
            count: 2
